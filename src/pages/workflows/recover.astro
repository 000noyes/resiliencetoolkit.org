---
import BaseLayout from '@/layouts/BaseLayout.astro';

// DRAFT: "Recovering after" path. The one sourced seed is Lena's note pointing to
// Mutual Aid / Neighbor to Neighbor (1.12). The rest stays an honest being-shaped
// invitation; no other recovery steps are fabricated.
---

<BaseLayout
  title="Recovering after | Workflows | Resilience Hub Toolkit"
  description="Recovering after a flood."
>
  <section class="py-12">
    <div class="container mx-auto px-4 max-w-3xl">
      <nav class="text-body-small text-muted-foreground mb-6" aria-label="Breadcrumb">
        <a href="/workflows" class="hover:text-primary underline underline-offset-2">Workflows</a>
        <span aria-hidden="true"> / </span>
        <span class="text-foreground">Recovering after</span>
      </nav>

      <h1 class="text-hero font-semibold mb-4 text-foreground">Recovering after</h1>

      <!-- One sourced seed (Lena's note): point the "after" path to Mutual Aid /
           Neighbor to Neighbor. No other recovery steps are invented. -->
      <div class="rounded-lg border-t-4 border-t-secondary border border-border bg-card p-6 shadow-card mb-6">
        <h2 class="text-title font-semibold text-foreground mb-3">Start with mutual aid</h2>
        <p class="text-body text-muted-foreground">
          For the weeks and months after a flood, begin with the toolkit's
          <a href="/modules/emergency-preparedness/1-12/" class="text-primary underline underline-offset-2">Mutual Aid / Neighbor to Neighbor</a>
          section.
        </p>
      </div>

      <!-- Being-shaped panel: intentional invitation, not an apology -->
      <div class="rounded-lg border border-dashed border-border bg-muted p-6">
        <h2 class="text-title font-semibold text-foreground mb-3">The rest of this path is still being shaped</h2>
        <p class="text-body text-muted-foreground">
          We are writing it with people who have lived recovery. If that is you, we
          would like your input.
        </p>
      </div>

      <nav class="flex items-center justify-between border-t border-border mt-10 pt-6 text-body-small" aria-label="Path navigation">
        <a href="/workflows/response" class="text-muted-foreground hover:text-primary underline underline-offset-2">&larr; Responding to a flood</a>
        <a href="/workflows" class="text-primary font-medium underline underline-offset-2">All workflows</a>
      </nav>
    </div>
  </section>
</BaseLayout>
