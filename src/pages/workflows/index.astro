---
import BaseLayout from '@/layouts/BaseLayout.astro';
import RecoveryContinuum from '@/components/RecoveryContinuum.astro';

// Resilience Workflows hub: the FEMA Disaster Recovery Continuum is the page's
// primary wayfinding, rendered by RecoveryContinuum (FEMA's official continuum
// graphic with the phases mapped to toolkit workflows in columns beneath it).
// Wayfinding only; nodes carry routes + phases + timeframes, never Drive URLs.
---

<BaseLayout
  title="Workflows | Community Resilience Hub Toolkit"
  description="A guided path through the toolkit, organized by where you are relative to a flood: before, responding, and recovering."
>
  <section class="py-12">
    <div class="container mx-auto px-4 max-w-5xl">
      <p class="text-label uppercase-accent text-primary mb-3">Draft</p>
      <h1 class="text-hero font-semibold mb-3 text-foreground">Resilience Workflows</h1>
      <p class="text-body-large text-muted-foreground leading-relaxed">
        Choose where you are relative to a flood.
      </p>
    </div>
  </section>

  <section class="pb-16">
    <div class="container mx-auto px-4 max-w-5xl">
      <RecoveryContinuum />
    </div>
  </section>
</BaseLayout>
