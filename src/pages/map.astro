---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ActionButton from '@/components/ActionButton.astro';
import ExternalLink from '@/components/ExternalLink.astro';
import { MapPin } from 'lucide-react';
---

<BaseLayout title="Community Assets & Resources - Resilience Hub" description="Access the Vermont Town Directory and local assets directory for people, places, and resources">
  <div class="container mx-auto px-4 py-12 max-w-6xl">
    <!-- Page Header -->
    <header class="mb-12">
      <h1 class="text-hero font-semibold mb-4">
        Find Your Town
      </h1>
      <p class="text-lg text-text-secondary">
        Access the Vermont Town Directory and local asset mapping tools to connect with your community's resources and networks.
      </p>
    </header>

    <!-- Featured: Vermont Town Directory - Hero Banner -->
    <section class="mb-16">
      <div class="bg-gradient-to-br from-primary/10 via-primary/5 to-background border border-primary/20 rounded-lg p-8 md:p-12">
        <div class="flex flex-col items-center text-center max-w-3xl mx-auto">
          <!-- Icon -->
          <div class="mb-6 text-primary">
            <MapPin size={48} strokeWidth={1.5} />
          </div>

          <!-- Title -->
          <h2 class="text-3xl md:text-4xl font-bold text-foreground mb-4">
            Vermont Town Directory
          </h2>

          <!-- Description -->
          <p class="text-lg text-muted-foreground mb-6">
            Learn about jurisdictions and service areas for your town—what county you're in, which Regional Planning Commission (RPC) to ask for technical assistance, and which Long Term Recovery Group (LTRG) can help you if individuals are impacted by flooding.
          </p>

          <!-- Live Vermont Town Directory sheet, shared by the coalition 2026-06-29. -->
          <ExternalLink
            href="https://docs.google.com/spreadsheets/d/17SYNgwm49HYJ2YZm_hskr9mrPq7NcxofVJ9OSsph2ls/edit?usp=sharing"
            class="inline-block"
          >
            <ActionButton
              variant="primary"
              size="lg"
              class="pointer-events-none"
            >
              View Town Directory
            </ActionButton>
          </ExternalLink>
        </div>
      </div>
    </section>

    <!-- Asset Map Section -->
    <section>
      <h2 class="text-2xl font-semibold text-foreground mb-4">
        Community Resilience Organizations Map
      </h2>
      <p class="text-muted-foreground mb-6">
        Static map showing regional service areas for CROs and partners across Vermont. Click the map to view it full-size in a new tab.
      </p>
      <a
        href="/map/251111_CROS Map.png"
        target="_blank"
        rel="noopener noreferrer"
        class="group block rounded-lg overflow-hidden shadow-card hover:shadow-lg transition-shadow cursor-pointer"
        style="outline: none !important;"
      >
        <img
          src="/map/251111_CROS Map.png"
          alt="CROS Community Resilience Map - showing regional service areas and resources"
          class="w-full h-auto"
          loading="lazy"
        />
      </a>
      <p class="text-sm text-muted-foreground mt-4 text-center">
        Click map to view full size • Interactive features coming soon
      </p>
    </section>
  </div>
</BaseLayout>
