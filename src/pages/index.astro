  <!-- Module Explorer Interactivity -->
  <script is:inline>
    (() => {
      const run = () => {
        if (typeof window === 'undefined') return;

        // Phase filter functionality
        const filterGroup = document.querySelector('[data-phase-filter-group]');
        const filterButtons = filterGroup?.querySelectorAll('[data-phase-filter]');
        const modulePills = document.querySelectorAll('[data-module-pill]');

        if (filterButtons && modulePills.length) {
          filterButtons.forEach((btn) => {
            btn.addEventListener('click', () => {
              const phase = btn.getAttribute('data-phase-filter');

              // Update button states
              filterButtons.forEach((b) => {
                const isActive = b === btn;
                b.setAttribute('aria-pressed', isActive ? 'true' : 'false');
                b.classList.toggle('bg-primary', isActive);
                b.classList.toggle('text-primary-foreground', isActive);
                b.classList.toggle('shadow-sm', isActive);
                b.classList.toggle('text-muted-foreground', !isActive);
                b.classList.toggle('bg-muted/50', !isActive);
              });

              // Filter modules (phaseless modules always visible)
              modulePills.forEach((pill) => {
                const pillPhases = pill.getAttribute('data-module-phases');
                const phases = pillPhases ? pillPhases.split(',') : [];
                // Show if: "All" selected, OR module has no phases, OR module includes selected phase
                const shouldShow = phase === 'All' || phases.length === 0 || phases.includes(phase);

                pill.style.display = shouldShow ? '' : 'none';
                pill.setAttribute('aria-hidden', shouldShow ? 'false' : 'true');
              });
            });
          });
        }

        // Desktop detail panel hover functionality
        const detailPanel = document.querySelector('[data-detail-panel]');
        const detailPlaceholder = document.querySelector('[data-detail-placeholder]');
        const detailContent = document.querySelector('[data-detail-content]');
        const detailTitle = document.querySelector('[data-detail-title]');
        const detailSummary = document.querySelector('[data-detail-summary]');

        // Mobile detail panel elements
        const mobilePanel = document.querySelector('[data-mobile-detail-panel]');
        const mobileTitle = document.querySelector('[data-mobile-detail-title]');
        const mobileSummary = document.querySelector('[data-mobile-detail-summary]');
        const mobileLink = document.querySelector('[data-mobile-detail-link]');

        const showDesktopDetail = (pill) => {
          const title = pill.getAttribute('data-module-title');
          const summary = pill.getAttribute('data-module-summary');

          if (detailTitle) detailTitle.textContent = title;
          if (detailSummary) detailSummary.textContent = summary;
          if (detailPlaceholder) detailPlaceholder.classList.add('hidden');
          if (detailContent) detailContent.classList.remove('hidden');
        };

        const hideDesktopDetail = () => {
          if (detailPlaceholder) detailPlaceholder.classList.remove('hidden');
          if (detailContent) detailContent.classList.add('hidden');
        };

        const showMobileDetail = (pill) => {
          const title = pill.getAttribute('data-module-title');
          const summary = pill.getAttribute('data-module-summary');
          const url = pill.getAttribute('href');

          if (mobileTitle) mobileTitle.textContent = title;
          if (mobileSummary) mobileSummary.textContent = summary;
          if (mobileLink) mobileLink.setAttribute('href', url);
          if (mobilePanel) mobilePanel.classList.remove('hidden');
        };

        if (modulePills.length) {
          modulePills.forEach((pill) => {
            // Desktop: hover and focus
            pill.addEventListener('mouseenter', () => showDesktopDetail(pill));
            pill.addEventListener('focus', () => showDesktopDetail(pill));

            // Mobile: show detail on focus (touch triggers focus)
            pill.addEventListener('focus', () => {
              if (window.innerWidth < 1024) {
                showMobileDetail(pill);
              }
            });
          });

          // Hide desktop detail when leaving the pills area
          const pillsContainer = document.querySelector('[data-module-pills]');
          if (pillsContainer && detailPanel) {
            pillsContainer.addEventListener('mouseleave', hideDesktopDetail);
          }
        }
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', run, { once: true });
      } else {
        run();
      }
    })();
  </script>

  <script
    type="application/json"
    id="fieldSnapshotData"
    set:html={JSON.stringify(fieldSnapshots).replace(/</g, '\\u003c')}
  ></script>
  <script is:inline>
    (() => {
      const run = () => {
        if (typeof window === 'undefined') {
          return;
        }

        const dataEl = document.getElementById('fieldSnapshotData');
        if (!dataEl) {
          return;
        }

        let snapshots = [];
        try {
          snapshots = JSON.parse(dataEl.textContent ?? '[]');
        } catch (error) {
          console.warn('Unable to parse field snapshot data', error);
          return;
        }

        if (!Array.isArray(snapshots) || snapshots.length === 0) {
          return;
        }

        const figure = document.querySelector('[data-field-snapshot]');
        if (figure) {
          const img = figure.querySelector('[data-field-image]');
          const label = figure.querySelector('[data-field-label]');
          const caption = figure.querySelector('[data-field-caption]');
          const storageKey = 'fieldSnapshotIndex';
          let storedIndex = -1;

          try {
            const storedValue = window.localStorage?.getItem(storageKey);
            const parsed = Number(storedValue);
            storedIndex = Number.isInteger(parsed) ? parsed : -1;
          } catch (error) {
            console.warn('Unable to read snapshot index from storage', error);
          }

          const nextIndex = (storedIndex + 1) % snapshots.length;
          try {
            window.localStorage?.setItem(storageKey, String(nextIndex));
          } catch (error) {
            console.warn('Unable to persist snapshot index', error);
          }

          const snapshot = snapshots[nextIndex];
          if (img && snapshot?.image) {
            img.src = snapshot.image;
            if (snapshot.alt) {
              img.alt = snapshot.alt;
            }
          }
          if (label && snapshot?.label) {
            label.textContent = snapshot.label;
          }
          if (caption && snapshot?.caption) {
            caption.textContent = snapshot.caption;
          }
        }

        const openBtn = document.querySelector('[data-snapshot-gallery-open]');
        const dialog = document.querySelector('[data-snapshot-gallery-dialog]');
        const closeBtn = dialog?.querySelector('[data-snapshot-gallery-close]');

        if (openBtn && dialog && typeof dialog.showModal === 'function') {
          openBtn.addEventListener('click', () => dialog.showModal());
          closeBtn?.addEventListener('click', () => dialog.close());
          dialog.addEventListener('click', (event) => {
            if (event.target === dialog) {
              dialog.close();
            }
          });
        }

        const detailDialog = document.querySelector('[data-snapshot-detail-dialog]');
        const detailClose = detailDialog?.querySelector('[data-snapshot-detail-close]');
        const detailImage = detailDialog?.querySelector('[data-detail-image]');
        const detailCaption = detailDialog?.querySelector('[data-detail-caption]');
        const detailAlt = detailDialog?.querySelector('[data-detail-alt]');

        if (detailDialog && typeof detailDialog.showModal === 'function') {
          document.querySelectorAll('[data-snapshot-detail-trigger]').forEach((trigger) => {
            trigger.addEventListener('click', () => {
              const image = trigger.getAttribute('data-image');
              const caption = trigger.getAttribute('data-caption');
              const alt = trigger.getAttribute('data-alt');

              if (detailImage && image) {
                detailImage.src = image;
                detailImage.alt = alt ?? '';
              }
              if (detailCaption) {
                detailCaption.textContent = caption ?? '';
              }
              if (detailAlt) {
                detailAlt.textContent = alt ?? '';
              }

              detailDialog.showModal();
            });
          });

          detailClose?.addEventListener('click', () => detailDialog.close());
          detailDialog.addEventListener('click', (event) => {
            if (event.target === detailDialog) {
              detailDialog.close();
            }
          });
        }
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', run, { once: true });
      } else {
        run();
      }
    })();
  </script>
