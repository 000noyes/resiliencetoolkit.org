---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ActionButton from '@/components/ActionButton.astro';
import Badge from '@/components/Badge.astro';
import Card from '@/components/Card.astro';
import { modules, getPhaseCounts, phaseDotColors } from '@/data/modules';

// Phase filter configuration
const phases = ['All', 'Before', 'During', 'After'] as const;
const phaseCounts = getPhaseCounts();

const fieldSnapshots = [
  {
    label: 'Field Snapshot',
    image: '/images/culvert-road.png',
    alt: 'Orange road-closed sign blocking a rural Vermont dirt road for culvert repairs.',
    caption: 'Road closed for culvert repair, July 2023'
  },
  {
    label: 'Field Snapshot',
    image: '/images/river-bend-washout.png',
    alt: 'River bend washout where floodwaters carved a channel dangerously close to the gravel road.',
    caption: 'River bend washout cutting off access, July 2023'
  }
];

const defaultSnapshot = fieldSnapshots[0];
---

<BaseLayout
  title="Resilience Hub Toolkit | Build a Community Resilience Hub"
  description="Local-first tools to organize systems, stuff, and people before, during, and after disasters."
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-b from-primary/10 to-background pt-16 pb-8">
    <div class="container mx-auto px-4 text-center max-w-4xl">
      <div class="flex justify-center mb-6">
        <Badge variant="success">Born When the Water Rose</Badge>
      </div>

      <h1 class="text-hero font-semibold mb-5 text-foreground">
        Build a Community Resilience Hub
      </h1>

      <!-- <p class="text-body text-muted-foreground mb-6 max-w-3xl mx-auto">
        Made with first responders, volunteers, and neighbors who needed a simpler way to coordinate.
      </p> -->

      <p class="text-body-large text-muted-foreground mb-6 max-w-2xl mx-auto">
        This toolkit brings the lessons learned from Vermont's 2023-2024 floods to communities everywhere. Start planning your hub today.
      </p>

      <div class="flex flex-wrap gap-4 justify-center">
        <ActionButton href="/introduction" variant="primary" size="lg">
          Open the Toolkit
        </ActionButton>
        <ActionButton href="/downloads" variant="outline" size="lg">
          Download PDF
        </ActionButton>
      </div>

      <p class="mt-5 mb-10 text-body text-muted-foreground font-medium">
        Works even when the internet doesn't.<a href="#offline" class="text-primary no-underline hover:underline">*</a>
      </p>
    </div>
  </section>

  <!-- Funding Announcement (hidden — uncomment to reuse as announcement bar)
  <div class="container mx-auto px-4 max-w-4xl py-8">
    <a
      href="https://docs.google.com/forms/d/e/1FAIpQLSdByTx8na9ySzeD7LJLhZ9-O_n89Vm7rrApp3IayDyKORwhbA/viewform"
      target="_blank"
      rel="noopener noreferrer"
      class="block bg-amber-50 dark:bg-amber-950/30 border-2 border-amber-300 dark:border-amber-700 rounded-xl px-6 py-6 md:px-8 hover:bg-amber-100/80 dark:hover:bg-amber-950/50 hover:border-amber-400 dark:hover:border-amber-600 shadow-[0_0_20px_-4px_rgba(245,158,11,0.25)] hover:shadow-[0_0_28px_-4px_rgba(245,158,11,0.4)] transition-all no-underline group"
    >
      <div class="flex items-center gap-5">
        <div class="w-12 h-12 rounded-xl bg-amber-200/50 dark:bg-amber-800/30 flex items-center justify-center flex-shrink-0">
          <svg class="w-6 h-6 text-amber-700 dark:text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div class="flex-1 min-w-0">
          <p class="text-base font-semibold text-foreground mb-1">
            Funding Available: LAOB Community Resilience Award
          </p>
          <p class="text-sm text-muted-foreground mb-0">
            The Land Access and Opportunity Board is offering up to $50,000 for Vermont communities building resilience hubs. Submit your Letter of Intent to get started.
          </p>
        </div>
        <span class="hidden sm:inline-flex items-center gap-1.5 font-medium text-sm text-primary group-hover:text-primary/80 flex-shrink-0 bg-primary/10 px-4 py-2 rounded-lg group-hover:bg-primary/15 transition-colors">
          Apply now
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
        </span>
      </div>
      <span class="inline-flex items-center gap-1 font-medium text-sm text-primary mt-3 sm:hidden">
        Apply now
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
      </span>
    </a>
  </div>
  -->

  <!-- Explore the Toolkit Section -->
  <section class="py-12 bg-card" id="explore-toolkit">
    <div class="container mx-auto px-4 max-w-4xl">
      <div class="bg-background border border-border rounded-3xl shadow-xl px-6 py-10 md:px-12 md:py-12">

        <!-- Header -->
        <div class="text-center mb-8">
          <h2 class="text-headline font-semibold text-foreground mb-3">
            Explore the toolkit yourself.
          </h2>
          <p class="text-body-large text-muted-foreground max-w-2xl mx-auto">
            Select a phase or topic to jump into the guides. Everything works offline.
          </p>
        </div>

        <!-- Phase Filter Pills -->
        <div
          class="flex flex-wrap justify-center gap-2 mb-8"
          role="group"
          aria-label="Filter modules by phase"
          data-phase-filter-group
        >
          {phases.map((phase, index) => (
            <button
              type="button"
              class:list={[
                'px-4 py-2 rounded-full text-body font-medium',
                'transition-all duration-200',
                'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2',
                index === 0
                  ? 'bg-primary text-primary-foreground shadow-sm'
                  : 'text-muted-foreground bg-muted/50 hover:text-foreground hover:bg-muted'
              ]}
              data-phase-filter={phase}
              aria-pressed={index === 0 ? 'true' : 'false'}
            >
              {phase}
              <span class="ml-1.5 text-body-small opacity-75">
                ({phaseCounts[phase as keyof typeof phaseCounts]})
              </span>
            </button>
          ))}
        </div>

        <!-- Module Explorer: Pills + Detail Panel -->
        <div class="flex flex-col lg:flex-row gap-6 mb-8" data-module-explorer>

          <!-- Module Pills Grid -->
          <div class="flex-1">
            <div
              class="flex flex-wrap gap-3 justify-center lg:justify-start"
              role="list"
              aria-label="Toolkit modules"
              data-module-pills
            >
              {modules.map((module) => (
                <a
                  href={module.url}
                  class:list={[
                    'group inline-flex items-center gap-2',
                    'px-4 py-2.5 rounded-full',
                    'border border-border bg-card',
                    'text-body font-medium text-foreground',
                    'transition-all duration-200',
                    'hover:-translate-y-0.5 hover:shadow-lg hover:border-primary/50',
                    'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2',
                  ]}
                  data-module-pill
                  data-module-slug={module.slug}
                  data-module-phases={module.frontmatter.phases?.join(',') || ''}
                  data-module-summary={module.frontmatter.summary}
                  data-module-title={module.frontmatter.title}
                >
                  <module.icon
                    className="w-5 h-5 text-primary flex-shrink-0 transition-transform duration-200 group-hover:scale-110"
                    strokeWidth={1.5}
                  />
                  <span>{module.frontmatter.title}</span>
                  {module.frontmatter.phases && module.frontmatter.phases.length > 0 && (
                    <span class="flex gap-0.5 ml-1">
                      {module.frontmatter.phases.map((phase) => (
                        <span
                          class={`w-2 h-2 rounded-full ${phaseDotColors[phase]}`}
                          title={phase}
                        />
                      ))}
                    </span>
                  )}
                </a>
              ))}
            </div>

            <!-- Mobile Detail Panel (shown below pills on small screens) -->
            <div
              class="lg:hidden mt-4 hidden"
              data-mobile-detail-panel
            >
              <div class="p-4 rounded-xl bg-muted/30 border border-border">
                <h4 class="text-subtitle font-semibold text-foreground mb-2" data-mobile-detail-title></h4>
                <p class="text-body-small text-muted-foreground mb-3" data-mobile-detail-summary></p>
                <a
                  href="#"
                  class="inline-flex items-center gap-1 text-primary font-medium text-body-small hover:underline"
                  data-mobile-detail-link
                >
                  Open module
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </div>
          </div>

          <!-- Desktop Detail Panel (sticky on right side) -->
          <div
            class="lg:w-72 flex-shrink-0 hidden lg:block"
            data-detail-panel
            aria-live="polite"
          >
            <div class="sticky top-24 p-5 rounded-xl bg-muted/30 border border-border min-h-[140px]">
              <p class="text-body-small text-muted-foreground italic" data-detail-placeholder>
                Hover over a module to see its description.
              </p>
              <div class="hidden" data-detail-content>
                <h4 class="text-subtitle font-semibold text-foreground mb-2" data-detail-title></h4>
                <p class="text-body-small text-muted-foreground" data-detail-summary></p>
              </div>
            </div>
          </div>
        </div>

        <!-- Search Row -->
        <div class="mb-8" data-pagefind-search>
          <div class="flex flex-col sm:flex-row gap-3 items-stretch sm:items-center justify-center">
            <p class="text-body-small text-muted-foreground text-center sm:text-left">
              Or search by keyword:
            </p>
            <div class="relative w-full sm:w-80">
              <div class="absolute left-4 top-1/2 -translate-y-1/2 text-muted-foreground pointer-events-none">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="11" cy="11" r="8"></circle>
                  <path d="m21 21-4.35-4.35"></path>
                </svg>
              </div>
              <input
                type="search"
                id="pagefind-search"
                placeholder="Try 'mutual aid' or 'go bag'"
                autocomplete="off"
                class:list={[
                  'w-full h-12 pl-12 pr-4',
                  'bg-input border border-border rounded-lg',
                  'text-body text-foreground placeholder:text-muted-foreground',
                  'shadow-[inset_0_1px_2px_rgba(0,0,0,0.05)]',
                  'transition-all duration-200',
                  'focus:outline-none focus:ring-2 focus:ring-ring focus:border-transparent focus:bg-background',
                  'hover:bg-muted'
                ]}
              />
            </div>
          </div>

          <!-- Search Results Container -->
          <div
            class="mt-4 rounded-xl border border-border bg-card overflow-hidden hidden"
            data-search-results
          >
            <div class="p-4 text-center text-body-small text-muted-foreground" data-search-status>
              Searching...
            </div>
            <div data-search-hits></div>
          </div>
        </div>

        <!-- CTA Button -->
        <div class="text-center">
          <ActionButton href="/modules" variant="primary" size="lg">
            Explore All Modules
          </ActionButton>
        </div>

        <!-- No-JS Fallback -->
        <noscript>
          <div class="mt-8 p-6 bg-muted/30 rounded-xl border border-border">
            <h3 class="text-subtitle font-semibold text-foreground mb-4">All Modules</h3>
            <ul class="space-y-3">
              {modules.map((module) => (
                <li>
                  <a
                    href={module.url}
                    class="text-primary hover:underline font-medium"
                  >
                    {module.frontmatter.title}
                  </a>
                  <span class="text-muted-foreground ml-2">
                    — {module.frontmatter.summary}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </noscript>

      </div>
    </div>
  </section>

  <!-- Field Snapshot -->
  <section class="relative z-10 py-12 px-4">
    <div class="mx-auto max-w-5xl">
      <figure class="bg-background border border-border rounded-3xl shadow-2xl overflow-hidden" data-field-snapshot>
        <div class="relative h-64 sm:h-72 md:h-80">
          <img
            src={defaultSnapshot.image}
            alt={defaultSnapshot.alt}
            class="w-full h-full object-cover"
            loading="lazy"
            decoding="async"
            data-field-image
          />
          <span class="absolute top-4 left-4 bg-primary/90 text-white text-xs font-semibold tracking-wide uppercase px-3 py-1 rounded-full shadow-lg backdrop-blur" data-field-label>
            {defaultSnapshot.label}
          </span>
          <span class="absolute bottom-4 left-4 inline-flex items-center rounded-full bg-black/90 text-white text-sm sm:text-base font-medium px-4 py-1.5 shadow-lg backdrop-blur border border-white/20" data-field-caption>
            {defaultSnapshot.caption}
          </span>
          <button
            type="button"
            class="absolute top-4 right-4 inline-flex items-center gap-1 rounded-full bg-primary/90 text-white text-xs font-semibold tracking-wide uppercase px-3 py-1 shadow-lg backdrop-blur hover:bg-primary transition-colors"
            data-snapshot-gallery-open
          >
            View gallery
          </button>
        </div>
      </figure>
    </div>
  </section>

  <dialog
    data-snapshot-gallery-dialog
    class="rounded-3xl border border-border p-0 w-[min(90vw,640px)] bg-background text-foreground shadow-2xl backdrop:bg-black/60"
  >
    <div class="p-6 sm:p-8 space-y-6">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-xs font-semibold tracking-wide text-primary uppercase">Gallery</p>
          <h3 class="text-title font-semibold text-foreground">Field Snapshots</h3>
        </div>
        <button
          type="button"
          class="text-sm font-medium text-muted-foreground hover:text-foreground transition-colors"
          data-snapshot-gallery-close
        >
          Close
        </button>
      </div>
      <div class="grid grid-cols-1 gap-4">
        {fieldSnapshots.map((shot, idx) => (
          <button
            type="button"
            class="text-left overflow-hidden rounded-2xl border border-border bg-card hover:-translate-y-0.5 hover:shadow-lg transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
            data-snapshot-detail-trigger
            data-image={shot.image}
            data-alt={shot.alt}
            data-caption={shot.caption}
          >
            <figure>
              <div class="h-48 sm:h-56">
                <img
                  src={shot.image}
                  alt={shot.alt}
                  class="w-full h-full object-cover"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <figcaption class="p-4">
                <p class="text-sm font-semibold text-foreground">{shot.caption}</p>
                <p class="text-xs text-muted-foreground mt-1">{shot.alt}</p>
              </figcaption>
            </figure>
          </button>
        ))}
      </div>
    </div>
  </dialog>

  <dialog
    data-snapshot-detail-dialog
    class="rounded-2xl border border-border p-0 w-[min(98vw,1600px)] h-[min(96vh,1200px)] bg-background text-foreground shadow-2xl backdrop:bg-black/80"
  >
    <div class="flex flex-col h-full p-3 sm:p-4">
      <div class="flex items-center justify-between gap-4 mb-3">
        <p class="text-sm font-semibold text-primary uppercase tracking-wide">Field Snapshot</p>
        <button
          type="button"
          class="text-sm font-medium text-muted-foreground hover:text-foreground transition-colors"
          data-snapshot-detail-close
        >
          Close
        </button>
      </div>
      <div class="flex-1 min-h-0 rounded-xl overflow-hidden border border-border">
        <img
          src=""
          alt=""
          class="w-full h-full object-contain"
          loading="lazy"
          decoding="async"
          data-detail-image
        />
      </div>
      <div class="mt-3">
        <p class="text-base font-semibold text-foreground" data-detail-caption></p>
        <p class="text-sm text-muted-foreground mt-1" data-detail-alt></p>
      </div>
    </div>
  </dialog>

  <!-- Origin Story Section -->
  <section class="py-12 bg-card">
    <div class="container mx-auto px-4 max-w-4xl">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        <!-- Problem -->
        <div>
          <Badge variant="warning" class="mb-4">The Challenge</Badge>
          <h2 class="text-title font-semibold mb-3 text-foreground">
            2023 and 2024 Floods Left Vermont Communities Scrambling
          </h2>
          <p class="text-body text-muted-foreground mb-4">
            When the waters rose, government response was slow. Resources were scattered.
            People needed to organize supplies, volunteers, and information, but had no
            clear framework.
          </p>
          <p class="text-body text-muted-foreground">
            Neighbors became first responders by necessity, not by choice.
          </p>
        </div>

        <!-- Solution -->
        <div>
          <Badge variant="success" class="mb-4">What We Built</Badge>
          <h2 class="text-title font-semibold mb-3 text-foreground">
            Frontline Responders Created This Toolkit
          </h2>
          <p class="text-body text-muted-foreground mb-4">
            Community organizers, mutual aid groups, and flood survivors documented
            what actually worked. The result: a free, tested framework any community
            can use to build resilience before disaster strikes.
          </p>
          <p class="text-body text-muted-foreground">
            We made this because we needed it when the waters rose.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="py-12">
    <div class="container mx-auto px-4 max-w-4xl">
      <h2 class="text-headline font-semibold text-center text-foreground mb-10">
        Before, During, and After
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Before -->
        <div class="text-center p-6">
          <div class="w-16 h-16 mx-auto mb-3 rounded-full bg-blue-100 dark:bg-blue-900 flex items-center justify-center">
            <svg class="w-8 h-8 text-blue-600 dark:text-blue-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
            </svg>
          </div>
          <h3 class="text-subtitle font-semibold text-foreground mb-2">Before</h3>
          <p class="text-body-small text-muted-foreground">
            Map assets, build networks, prepare supplies, and train volunteers before disaster strikes.
          </p>
        </div>

        <!-- During -->
        <div class="text-center p-6">
          <div class="w-16 h-16 mx-auto mb-3 rounded-full bg-orange-100 dark:bg-orange-900 flex items-center justify-center">
            <svg class="w-8 h-8 text-orange-600 dark:text-orange-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
          </div>
          <h3 class="text-subtitle font-semibold text-foreground mb-2">During</h3>
          <p class="text-body-small text-muted-foreground">
            Coordinate response, track needs, manage volunteers, and communicate with your community.
          </p>
        </div>

        <!-- After -->
        <div class="text-center p-6">
          <div class="w-16 h-16 mx-auto mb-3 rounded-full bg-green-100 dark:bg-green-900 flex items-center justify-center">
            <svg class="w-8 h-8 text-green-600 dark:text-green-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <h3 class="text-subtitle font-semibold text-foreground mb-2">After</h3>
          <p class="text-body-small text-muted-foreground">
            Track recovery progress, support rebuilding, and strengthen long-term community resilience.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Partner Organizations -->
  <section class="py-12">
    <div class="container mx-auto px-4 max-w-3xl">
      <h2 class="text-headline font-semibold mb-3 text-center text-foreground">
        Built With Grassroots Partners
      </h2>
      <p class="text-body text-muted-foreground mb-10 text-center max-w-xl mx-auto">
        In collaboration with frontline responders, community organizers,
        and mutual aid networks across Vermont:
      </p>

      <div class="text-center space-y-3">
        <p class="text-body text-foreground"><a href="https://www.accessecologies.com/" class="text-primary hover:underline">Access Ecologies</a></p>
        <p class="text-body text-foreground"><a href="https://gocros.org/" class="text-primary hover:underline">Community Resilience Organizations (CROs)</a></p>
        <p class="text-body text-foreground"><a href="https://www.thecrewvt.org/" class="text-primary hover:underline">Community Resilience for the Waterbury Area (CReW)</a></p>
        <p class="text-body text-foreground"><a href="https://www.cooperationvermont.org/" class="text-primary hover:underline">Cooperation Vermont</a></p>
        <p class="text-body text-foreground"><a href="https://www.morristownvt.gov/administration/page/learn-lamoille-area-recovery-network" class="text-primary hover:underline">Lamoille Area Recovery Network (LeARN)</a></p>
        <p class="text-body text-foreground"><a href="https://landaccessvt.org/" class="text-primary hover:underline">Land Access and Opportunity Board (LAOB)</a></p>
        <p class="text-body text-foreground"><a href="https://kurrve.org/" class="text-primary hover:underline">Kingdom United Resilience and Recovery Effort (KURRVE)</a></p>
        <p class="text-body text-foreground"><a href="https://nekorganizing.org/" class="text-primary hover:underline">Northeast Kingdom Organizing (NEKO)</a></p>
        <p class="text-body text-foreground"><a href="https://www.rosecorecollective.org/" class="text-primary hover:underline">Rose Core Collective</a></p>
        <p class="text-body text-foreground"><a href="https://www.ruralvermont.org/" class="text-primary hover:underline">Rural Vermont</a></p>
      </div>
    </div>
  </section>

  <!-- Offline Feature -->
  <section id="offline" class="py-12 bg-card">
    <div class="container mx-auto px-4 max-w-4xl">
      <div class="text-center mb-10">
        <Badge variant="primary" class="mb-4">Works Offline</Badge>
        <h2 class="text-headline font-semibold text-foreground mb-3">
          Works Without Internet After First Visit
        </h2>
        <p class="text-body-large text-muted-foreground max-w-2xl mx-auto">
          When disaster strikes, internet often goes down first. This toolkit was built
          to work completely offline, so you'll have access to all resources when you
          need them most.
        </p>
      </div>

