---
/**
 * A review round: the reviewed chapter rendered exactly as it ships, with
 * Make Comments turned on. The page is the chapter's own component; the
 * layout sees the /rounds/ URL and mounts the round strip, the Make
 * Comments tenant, and the annotation island (the P6 seam: identical
 * rail, identical page, only permissions widened).
 *
 * The route exists only on workshop builds: the round id (r1-<token>)
 * comes from the ROUND_ID build variable set on the workshop project, so
 * the token never lives in this repository and production builds emit
 * nothing under /rounds/. ROUND_PAGE names the reviewed chapter as a
 * path under src/pages/modules (default: the 1.2 chapter the boards
 * drew). The URL is direct-link-only: never in navigation, never in the
 * search index, never in sw.js (excluded from the precache generator).
 */
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';

export function getStaticPaths() {
  const roundId = process.env.ROUND_ID;
  if (!roundId) return [];
  return [{ params: { round: roundId } }];
}

const reviewed = process.env.ROUND_PAGE || 'emergency-preparedness/1-2';
const chapters = import.meta.glob<{ default: AstroComponentFactory }>('/src/pages/modules/**/*.astro');
const load = chapters[`/src/pages/modules/${reviewed}.astro`];
if (!load) {
  throw new Error(`ROUND_PAGE ${reviewed} is not a chapter under src/pages/modules`);
}
const Chapter = (await load()).default;
---

<Chapter />
