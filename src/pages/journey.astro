  <style>
    /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
    /*          CINEMATIC REVEAL SYSTEM             */
    /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */

    [data-reveal] {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
                  transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    }
    [data-reveal].revealed {
      opacity: 1;
      transform: translateY(0);
    }
    [data-reveal-delay="100"] { transition-delay: 100ms; }
    [data-reveal-delay="200"] { transition-delay: 200ms; }
    [data-reveal-delay="300"] { transition-delay: 300ms; }
    [data-reveal-delay="400"] { transition-delay: 400ms; }

    @media (prefers-reduced-motion: reduce) {
      [data-reveal] {
        opacity: 1;
        transform: none;
        transition: none;
      }
    }

    /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
    /*          PASSWORD GATE (Cinematic)           */
    /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */

    .password-gate {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100vh;
      z-index: 50;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 4rem 1rem;
      background: var(--muted);
      overflow: hidden;
    }
    .password-gate.hidden {
      display: none;
    }

    .password-gate::before {
      content: '';
      position: absolute;
      top: 40%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 500px;
      height: 500px;
      background: radial-gradient(circle, color-mix(in srgb, var(--primary) 6%, transparent), transparent 70%);
      pointer-events: none;
    }

    .password-gate__card {
      max-width: 24rem;
      width: 100%;
      padding: 2rem;
      border-radius: 16px;
      border: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
      background: color-mix(in srgb, var(--card) 80%, transparent);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      box-shadow:
        0 0 40px -8px color-mix(in srgb, var(--primary) 10%, transparent),
        0 8px 32px rgba(0, 0, 0, 0.08);
      position: relative;
      z-index: 1;
      transition: box-shadow 0.3s ease;
    }

    .password-gate__card.gate-error {
      box-shadow:
        0 0 40px -8px rgba(239, 68, 68, 0.3),
        0 8px 32px rgba(0, 0, 0, 0.08);
    }

    .password-gate__input {
      width: 100%;
      padding: 0.75rem 1rem;
      border-radius: 12px;
      border: 1px solid var(--border);
      background: var(--background);
      color: var(--foreground);
      font-family: inherit;
      font-size: 1rem;
      transition: all 0.2s ease;
    }
    .password-gate__input::placeholder { color: var(--muted-foreground); }
    .password-gate__input:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 20%, transparent),
                  0 0 16px -4px color-mix(in srgb, var(--primary) 15%, transparent);
    }

    .password-gate__submit {
      width: 100%;
      padding: 0.75rem 1rem;
      border-radius: 12px;
      border: none;
      background: var(--primary);
      color: var(--primary-foreground);
      font-family: inherit;
      font-size: 1rem;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.2s ease;
      box-shadow: 0 0 20px -4px color-mix(in srgb, var(--primary) 30%, transparent);
    }
    .password-gate__submit:hover {
      opacity: 0.92;
      box-shadow: 0 0 28px -4px color-mix(in srgb, var(--primary) 45%, transparent);
    }

    /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
    /*          CHAPTER NAV (Glassmorphism)         */
    /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */

    .chapter-nav {
      position: sticky;
      top: 56px;
      z-index: 40;
      background: color-mix(in srgb, var(--background) 88%, transparent);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
      border-top: 1px solid rgba(255, 255, 255, 0.06);
    }

    .chapter-nav__list {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 2px;
      list-style: none;
      padding: 8px 0;
      margin: 0;
    }

    .chapter-nav__list > li {
      display: flex;
      align-items: center;
    }

    .chapter-nav__vision-group {
      display: flex;
      align-items: center;
      gap: 0;
    }

    /* ── Chapter Buttons ── */

    .chapter-nav__btn {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 6px 14px;
      background: transparent;
      border: none;
      border-radius: 20px;
      cursor: pointer;
      transition: all 200ms ease;
      font-family: inherit;
    }

    .chapter-nav__btn:hover {
      background: color-mix(in srgb, var(--muted) 70%, transparent);
    }

    .chapter-nav__indicator {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--border);
      transition: all 250ms ease;
      flex-shrink: 0;
    }

    .chapter-nav__label {
      font-size: 13px;
      font-weight: 500;
      color: var(--muted-foreground);
      transition: all 200ms ease;
      white-space: nowrap;
    }

    /* ── Active states per chapter color ── */

    .chapter-nav__btn[aria-current="true"] {
      background: color-mix(in srgb, var(--muted) 50%, transparent);
    }

    .chapter-nav__btn[aria-current="true"] .chapter-nav__label {
      color: var(--foreground);
      font-weight: 600;
    }

    /* Proof — Amber */
    .chapter-nav__btn[data-chapter="proof"][aria-current="true"] .chapter-nav__indicator {
      background: rgb(234, 179, 8);
      box-shadow: 0 0 10px rgba(234, 179, 8, 0.5);
    }

    /* Vision — Green/Primary */
    .chapter-nav__btn[data-chapter="vision"][aria-current="true"] .chapter-nav__indicator {
      background: var(--primary);
      box-shadow: 0 0 10px color-mix(in srgb, var(--primary) 50%, transparent);
    }

    /* Process — Blue */
    .chapter-nav__btn[data-chapter="process"][aria-current="true"] .chapter-nav__indicator {
      background: rgb(59, 130, 246);
      box-shadow: 0 0 10px rgba(59, 130, 246, 0.5);
    }

    /* Scope — Neutral */
    .chapter-nav__btn[data-chapter="scope"][aria-current="true"] .chapter-nav__indicator {
      background: var(--muted-foreground);
      box-shadow: 0 0 8px color-mix(in srgb, var(--muted-foreground) 30%, transparent);
    }

    /* ── Vision Sub-markers (1 2 3 4) ── */

    .chapter-nav__sub {
      display: flex;
      align-items: center;
      gap: 3px;
      list-style: none;
      padding: 0;
      margin: 0;
      max-width: 0;
      overflow: hidden;
      opacity: 0;
      transition: max-width 300ms cubic-bezier(0.4, 0, 0.2, 1),
                  opacity 200ms ease,
                  margin 300ms ease;
      margin-left: 0;
    }

    .chapter-nav__btn--expandable[aria-expanded="true"] ~ .chapter-nav__sub {
      max-width: 140px;
      opacity: 1;
      margin-left: 4px;
    }

    .chapter-nav__sub-btn {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 11px;
      font-weight: 600;
      background: var(--muted);
      color: var(--muted-foreground);
      border: 1.5px solid var(--border);
      cursor: pointer;
      transition: all 200ms ease;
      font-family: inherit;
      padding: 0;
    }

    .chapter-nav__sub-btn:hover {
      border-color: var(--primary);
      color: var(--primary);
    }

    .chapter-nav__sub-btn[aria-current="true"] {
      background: var(--primary);
      color: var(--primary-foreground);
      border-color: var(--primary);
      box-shadow: 0 0 10px color-mix(in srgb, var(--primary) 40%, transparent);
    }

    /* ── Mobile ── */

    @media (max-width: 640px) {
      .chapter-nav__label { display: none; }
      .chapter-nav__btn { padding: 8px 10px; }
      .chapter-nav__indicator { width: 10px; height: 10px; }
      .chapter-nav__sub-btn { width: 20px; height: 20px; font-size: 10px; }
      .chapter-nav__btn--expandable[aria-expanded="true"] ~ .chapter-nav__sub {
        max-width: 110px;
      }
    }

    /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
    /*    PROOF SECTION — Amber Glow (subtle)       */
    /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */

    .proof-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 24px;
      box-shadow: 0 0 20px -4px rgba(245, 158, 11, 0.12);
      transition: box-shadow 0.3s ease;
    }
    .proof-card:hover {
      box-shadow: 0 0 28px -4px rgba(245, 158, 11, 0.25);
    }

    /* ── Infrastructure Grid ── */
    .infra-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }

    .infra-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 24px;
      box-shadow: 0 0 16px -4px rgba(245, 158, 11, 0.08);
      transition: all 0.3s ease;
    }
    .infra-card:hover {
      box-shadow: 0 0 24px -4px rgba(245, 158, 11, 0.22);
      transform: translateY(-2px);
      border-color: rgba(245, 158, 11, 0.3);
    }

    .infra-card__title {
      font-size: 1rem;
      font-weight: 600;
      color: var(--foreground);
      margin: 0 0 8px;
    }

    .infra-card__desc {
      font-size: 0.875rem;
      line-height: 1.5;
      color: var(--muted-foreground);
      margin: 0;
    }

    @media (max-width: 640px) {
      .infra-grid { grid-template-columns: 1fr; }
    }

    /* ── Dashboard Embed (Amber Glow — dramatic) ── */
    .dashboard-embed {
      border-radius: 16px;
      overflow: hidden;
      position: relative;
      background: var(--card);
      border: 2px solid transparent;
      background-image:
        linear-gradient(var(--card), var(--card)),
        linear-gradient(135deg, rgba(245, 158, 11, 0.45), rgba(245, 158, 11, 0.08) 50%, transparent);
      background-origin: border-box;
      background-clip: padding-box, border-box;
      box-shadow: 0 0 36px -6px rgba(245, 158, 11, 0.18);
      transition: box-shadow 0.3s ease;
    }
    .dashboard-embed:hover {
      box-shadow: 0 0 48px -6px rgba(245, 158, 11, 0.3);
    }

    .dashboard-embed__header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 20px;
      background: color-mix(in srgb, var(--muted) 80%, transparent);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--border);
    }

    .dashboard-embed__label {
      font-size: 13px;
      font-weight: 600;
      color: var(--foreground);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .dashboard-embed__label::before {
      content: '';
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: rgb(245, 158, 11);
      box-shadow: 0 0 8px rgba(245, 158, 11, 0.6);
      animation: pulse-dot 2s ease-in-out infinite;
    }

    @keyframes pulse-dot {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.4; }
    }

    .dashboard-embed__expand {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      font-weight: 600;
      color: var(--muted-foreground);
      background: color-mix(in srgb, var(--background) 60%, transparent);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 5px 12px;
      cursor: pointer;
      transition: all 0.2s ease;
      font-family: inherit;
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
    }
    .dashboard-embed__expand:hover {
      color: var(--foreground);
      border-color: rgba(245, 158, 11, 0.4);
      box-shadow: 0 0 12px -2px rgba(245, 158, 11, 0.2);
    }

    .dashboard-embed__frame {
      width: 100%;
      height: 340px;
      border: none;
      display: block;
    }

    .dashboard-embed__caption {
      padding: 16px 20px;
      border-top: 1px solid var(--border);
      text-align: center;
    }

    @media (max-width: 640px) {
      .dashboard-embed__header {
        flex-direction: column;
        gap: 4px;
        text-align: center;
      }
      .dashboard-embed__frame { height: 280px; }
    }

    /* ── Dashboard Fullscreen Dialog ── */
    .dashboard-dialog {
      padding: 0;
      border: none;
      border-radius: 16px;
      width: min(94vw, 1200px);
      height: min(90vh, 900px);
      background: var(--card);
      color: var(--foreground);
      box-shadow:
        0 0 60px -12px rgba(245, 158, 11, 0.2),
        0 24px 48px rgba(0, 0, 0, 0.15);
      overflow: hidden;
    }
    .dashboard-dialog::backdrop {
      background: rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
    }

    .dashboard-dialog__chrome {
      display: flex;
      flex-direction: column;
      height: 100%;
    }

    .dashboard-dialog__header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 20px;
      background: color-mix(in srgb, var(--muted) 80%, transparent);
      border-bottom: 1px solid var(--border);
      flex-shrink: 0;
    }

    .dashboard-dialog__close {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 13px;
      font-weight: 500;
      color: var(--muted-foreground);
      background: transparent;
      border: none;
      cursor: pointer;
      padding: 4px 8px;
      border-radius: 6px;
      font-family: inherit;
      transition: all 0.15s ease;
    }
    .dashboard-dialog__close:hover {
      color: var(--foreground);
      background: var(--muted);
    }

    .dashboard-dialog__frame {
      width: 100%;
      flex: 1;
      border: none;
      display: block;
    }

    /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
    /*   VISION SECTION — Primary/Green Glow        */
    /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */

    /* ── Dashboard Preview Card ── */
    .dashboard-preview {
      background: var(--card);
      border: 1px solid var(--primary);
      border-radius: 12px;
      padding: 32px;
      position: relative;
      box-shadow: 0 0 24px -4px color-mix(in srgb, var(--primary) 18%, transparent);
    }

    .dashboard-preview::before {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 12px;
      background: color-mix(in srgb, var(--primary) 3%, transparent);
      pointer-events: none;
    }

    .dashboard-preview__dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--primary);
      margin-top: 7px;
      flex-shrink: 0;
      box-shadow: 0 0 8px color-mix(in srgb, var(--primary) 50%, transparent);
    }

    /* ── Journey Stages ── */
    .journey-stage {
      scroll-margin-top: 140px;
      position: relative;
      overflow: hidden;
    }

    /* Spotlight background on alternating stages */
    .journey-stage::before {
      content: '';
      position: absolute;
      top: -10%;
      left: 50%;
      transform: translateX(-50%);
      width: 600px;
      height: 600px;
      background: radial-gradient(circle, color-mix(in srgb, var(--primary) 4%, transparent), transparent 70%);
      pointer-events: none;
      z-index: 0;
    }

    .journey-stage > * {
      position: relative;
      z-index: 1;
    }

    .journey-stage__header {
      text-align: center;
      margin-bottom: 48px;
    }

    .journey-stage__badge {
      display: inline-block;
      padding: 4px 16px;
      background: var(--primary);
      color: var(--primary-foreground);
      border-radius: 9999px;
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      margin-bottom: 16px;
      box-shadow: 0 0 16px color-mix(in srgb, var(--primary) 35%, transparent);
    }

    .journey-stage__title {
      font-size: clamp(2rem, 4vw, 2.75rem);
      font-weight: 600;
      color: var(--foreground);
      margin: 0 0 8px;
    }

    .journey-stage__description {
      font-size: 1.125rem;
      color: var(--muted-foreground);
      max-width: 600px;
      margin: 0 auto;
    }

    .journey-stage__cards {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    .journey-stage__connector {
      display: flex;
      justify-content: center;
      padding: 40px 0 0;
      color: var(--primary);
      opacity: 0.7;
    }

    .journey-stage__connector svg {
      filter: drop-shadow(0 0 6px color-mix(in srgb, var(--primary) 50%, transparent));
      animation: bounce-glow 2s ease-in-out infinite;
    }

    @keyframes bounce-glow {
      0%, 100% {
        transform: translateY(0);
        filter: drop-shadow(0 0 6px color-mix(in srgb, var(--primary) 50%, transparent));
      }
      50% {
        transform: translateY(6px);
        filter: drop-shadow(0 0 10px color-mix(in srgb, var(--primary) 70%, transparent));
      }
    }

    /* ── Journey Cards (Green Glow + Gradient Border) ── */
    .journey-card {
      display: flex;
      flex-direction: column;
      padding: 24px;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 12px;
      box-shadow: 0 0 16px -4px color-mix(in srgb, var(--primary) 12%, transparent);
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      text-decoration: none;
      color: inherit;
      position: relative;
    }

    /* Gradient border overlay on hover */
    .journey-card::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 12px;
      padding: 1px;
      background: linear-gradient(135deg, color-mix(in srgb, var(--primary) 60%, transparent), transparent 60%);
      -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor;
      mask-composite: exclude;
      opacity: 0;
      transition: opacity 0.3s ease;
      pointer-events: none;
    }

    .journey-card:hover {
      border-color: transparent;
      box-shadow: 0 0 24px -4px color-mix(in srgb, var(--primary) 30%, transparent);
      transform: translateY(-3px);
    }
    .journey-card:hover::after {
      opacity: 1;
    }

    .journey-card:focus-visible {
      outline: 2px solid var(--primary);
      outline-offset: 2px;
    }

    .journey-card__header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
    }

    .journey-card__number {
      font-size: 13px;
      font-weight: 700;
      color: var(--primary);
      background: color-mix(in srgb, var(--primary) 12%, transparent);
      padding: 2px 10px;
      border-radius: 6px;
    }

    .journey-card__phase {
      font-size: 11px;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      padding: 2px 8px;
      border-radius: 6px;
    }

    .journey-card__phase--before {
      color: var(--primary);
      background: color-mix(in srgb, var(--primary) 8%, transparent);
    }

    .journey-card__phase--during {
      color: var(--foreground);
      background: var(--muted);
    }

    .journey-card__title {
      font-size: 1.125rem;
      font-weight: 600;
      color: var(--foreground);
      margin: 0 0 6px;
      line-height: 1.3;
    }

    .journey-card__desc {
      font-size: 0.875rem;
      line-height: 1.5;
      color: var(--muted-foreground);
      margin: 0;
    }

    /* ── Module Embed Cards (Live Iframe Previews) ── */
    .module-embed {
      border-radius: 16px;
      overflow: hidden;
      background: var(--card);
      border: 1px solid var(--border);
      box-shadow: 0 0 16px -4px color-mix(in srgb, var(--primary) 12%, transparent);
      transition: all 0.3s ease;
    }
    .module-embed:hover {
      box-shadow: 0 0 24px -4px color-mix(in srgb, var(--primary) 25%, transparent);
    }

    .module-embed__header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 20px;
      background: color-mix(in srgb, var(--muted) 80%, transparent);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--border);
    }

    .module-embed__meta {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .module-embed__actions {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .module-embed__link {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 12px;
      font-weight: 500;
      color: var(--muted-foreground);
      text-decoration: none;
      padding: 5px 10px;
      border-radius: 6px;
      transition: all 0.2s ease;
    }
    .module-embed__link:hover {
      color: var(--foreground);
      background: color-mix(in srgb, var(--muted) 60%, transparent);
    }

    .module-embed__expand {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      font-weight: 600;
      color: var(--muted-foreground);
      background: color-mix(in srgb, var(--background) 60%, transparent);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 5px 12px;
      cursor: pointer;
      transition: all 0.2s ease;
      font-family: inherit;
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
    }
    .module-embed__expand:hover {
      color: var(--foreground);
      border-color: color-mix(in srgb, var(--primary) 40%, transparent);
      box-shadow: 0 0 12px -2px color-mix(in srgb, var(--primary) 20%, transparent);
    }

    .module-embed__title {
      font-size: 1.125rem;
      font-weight: 600;
      color: var(--foreground);
      padding: 12px 20px 0;
      margin: 0;
    }

    .module-embed__desc {
      font-size: 0.875rem;
      color: var(--muted-foreground);
      padding: 4px 20px 12px;
      margin: 0;
      line-height: 1.5;
    }

    .module-embed__frame {
      width: 100%;
      height: 340px;
      border: none;
      display: block;
    }

    @media (max-width: 640px) {
      .module-embed__header {
        flex-direction: column;
        gap: 8px;
      }
      .module-embed__frame { height: 280px; }
    }

    /* ── Module Fullscreen Dialog ── */
    .module-dialog {
      padding: 0;
      border: none;
      border-radius: 16px;
      width: min(94vw, 1200px);
      height: min(90vh, 900px);
      background: var(--card);
      color: var(--foreground);
      box-shadow:
        0 0 60px -12px color-mix(in srgb, var(--primary) 20%, transparent),
        0 24px 48px rgba(0, 0, 0, 0.15);
      overflow: hidden;
    }
    .module-dialog::backdrop {
      background: rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
    }

    .module-dialog__chrome {
      display: flex;
      flex-direction: column;
      height: 100%;
    }

    .module-dialog__header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 20px;
      background: color-mix(in srgb, var(--muted) 80%, transparent);
      border-bottom: 1px solid var(--border);
      flex-shrink: 0;
    }

    .module-dialog__header-actions {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .module-dialog__frame {
      width: 100%;
      flex: 1;
      border: none;
      display: block;
    }

    /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
    /*   PROCESS SECTION — Blue Glow (dramatic)     */
    /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */

    .process-phases {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      position: relative;
    }

    /* Ambient blue radial behind process cards */
    .process-phases::before {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 100%;
      height: 120%;
      background: radial-gradient(ellipse at center, rgba(59, 130, 246, 0.04), transparent 70%);
      pointer-events: none;
      z-index: 0;
    }

    .process-phase {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 28px 24px;
      position: relative;
      z-index: 1;
      box-shadow: 0 0 24px -4px rgba(59, 130, 246, 0.12);
      transition: all 0.3s ease;
      overflow: hidden;
    }

    /* Blue gradient top accent */
    .process-phase::before {
      content: '';
      position: absolute;
      top: 0;
      left: 24px;
      right: 24px;
      height: 2px;
      background: linear-gradient(90deg, transparent, rgba(59, 130, 246, 0.45), transparent);
      border-radius: 2px;
    }

    .process-phase:hover {
      box-shadow: 0 0 36px -4px rgba(59, 130, 246, 0.3);
      transform: translateY(-2px);
      border-color: rgba(59, 130, 246, 0.25);
    }

    .process-phase__number {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 15px;
      font-weight: 700;
      background: rgb(59, 130, 246);
      color: white;
      margin-bottom: 16px;
      box-shadow: 0 0 14px rgba(59, 130, 246, 0.35);
      transition: all 0.3s ease;
    }
    .process-phase:hover .process-phase__number {
      transform: scale(1.08);
      box-shadow: 0 0 20px rgba(59, 130, 246, 0.5);
    }

    .process-phase__title {
      font-size: 1.25rem;
      font-weight: 600;
      color: var(--foreground);
      margin: 0 0 4px;
    }

    .process-phase__period {
      font-size: 0.8125rem;
      color: var(--muted-foreground);
      margin: 0 0 16px;
    }

    .process-phase__list {
      list-style: none;
      padding: 0;
      margin: 0 0 16px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .process-phase__list li {
      font-size: 0.875rem;
      line-height: 1.5;
      color: var(--muted-foreground);
      padding-left: 16px;
      position: relative;
    }

    .process-phase__list li::before {
      content: '';
      position: absolute;
      left: 0;
      top: 8px;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: rgb(59, 130, 246);
      opacity: 0.5;
    }

    .process-phase__deliverable {
      font-size: 0.8125rem;
      color: var(--muted-foreground);
      padding-top: 12px;
      border-top: 1px solid var(--border);
      margin: 0;
    }

    @media (max-width: 768px) {
      .process-phases { grid-template-columns: 1fr; }
    }

    /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
    /*   SCOPE SECTION — Neutral Glow (calm)        */
    /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */

    .closing-quote {
      border-left: 4px solid var(--primary);
      padding-left: 1.5rem;
      padding-top: 0.5rem;
      padding-bottom: 0.5rem;
      position: relative;
    }
    .closing-quote::before {
      content: '';
      position: absolute;
      left: -2px;
      top: 0;
      bottom: 0;
      width: 4px;
      box-shadow: 0 0 12px color-mix(in srgb, var(--primary) 30%, transparent);
      pointer-events: none;
    }

    /* ── Presented By Signature ── */
    .presented-by {
      padding: 48px 16px 56px;
      text-align: center;
    }

    .presented-by__inner {
      display: inline-flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
    }

    .presented-by__label {
      font-size: 11px;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--muted-foreground);
    }

    .presented-by__logo-row {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .presented-by__logo {
      width: 36px;
      height: 36px;
      object-fit: contain;
    }

    .presented-by__name {
      font-size: 1.125rem;
      font-weight: 600;
      color: var(--foreground);
      letter-spacing: 0.01em;
    }

    /* ── Table Total Row ── */
    .total-row {
      background-color: var(--table-surface-subtle);
      border-top: 2px solid var(--table-divider);
    }
    .total-row td {
      padding-top: var(--spacing-md);
      padding-bottom: var(--spacing-md);
      font-size: 1.05em;
    }

    /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
    /*          TIER SWITCHER                        */
    /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */

    .tier-switcher {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      max-width: 480px;
    }

    .tier-switcher__tab {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
      padding: 16px 20px;
      border-radius: var(--radius-xl);
      border: 2px solid var(--border);
      background: var(--card);
      cursor: pointer;
      transition: all var(--motion-duration-base) var(--motion-easing-standard);
      font-family: inherit;
    }

    .tier-switcher__tab:hover {
      border-color: color-mix(in srgb, var(--primary) 40%, var(--border));
      box-shadow: 0 0 16px -4px color-mix(in srgb, var(--primary) 15%, transparent);
    }

    .tier-switcher__tab--active {
      border-color: var(--primary);
      background: color-mix(in srgb, var(--primary) 5%, var(--card));
      box-shadow: 0 0 20px -4px color-mix(in srgb, var(--primary) 25%, transparent);
    }

    .tier-switcher__label {
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--muted-foreground);
    }

    .tier-switcher__tab--active .tier-switcher__label {
      color: var(--primary);
    }

    .tier-switcher__price {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--foreground);
    }

    .tier-switcher__context {
      font-size: 0.75rem;
      color: var(--muted-foreground);
    }

    /* Tab panels */
    .tier-panel {
      display: none;
    }
    .tier-panel--active {
      display: block;
    }

    .tier-panel__header {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 12px;
      margin-bottom: 24px;
    }

    @media (max-width: 640px) {
      .tier-switcher {
        max-width: 100%;
      }
      .tier-switcher__price {
        font-size: 1.25rem;
      }
    }
  </style>
</BaseLayout>
