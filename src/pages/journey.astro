  <script is:inline>
    (() => {
      const CORRECT = 'laob';
      const KEY = 'journey-unlocked';

      const init = () => {
        const gate = document.getElementById('password-gate');
        const content = document.getElementById('proposal-content');
        const form = document.getElementById('password-form');
        const input = document.getElementById('password-input');
        const error = document.getElementById('password-error');

        if (sessionStorage.getItem(KEY) === 'true') {
          gate.classList.add('hidden');
          content.classList.remove('hidden');
          initChapterNav();
          initRevealAnimations();
          initDashboardDialog();
          initModuleDialogs();
          initTierSwitcher();
          return;
        }

        form.addEventListener('submit', (e) => {
          e.preventDefault();
          if (input.value.trim() === CORRECT) {
            sessionStorage.setItem(KEY, 'true');
            gate.classList.add('hidden');
            content.classList.remove('hidden');
            initChapterNav();
            initRevealAnimations();
            initDashboardDialog();
            initModuleDialogs();
            initTierSwitcher();
          } else {
            error.classList.remove('hidden');
            input.value = '';
            input.focus();
            // Red glow flash on card
            const card = gate.querySelector('.password-gate__card');
            if (card) {
              card.classList.add('gate-error');
              setTimeout(() => card.classList.remove('gate-error'), 600);
            }
            setTimeout(() => error.classList.add('hidden'), 3000);
          }
        });
      };

      function initChapterNav() {
        const chapterIds = ['chapter-proof', 'chapter-vision', 'chapter-process', 'chapter-scope'];
        const chapterEls = chapterIds.map(id => document.getElementById(id)).filter(Boolean);
        const chapterBtns = document.querySelectorAll('.chapter-nav__btn');
        const subStages = document.querySelectorAll('.journey-stage');
        const subBtns = document.querySelectorAll('.chapter-nav__sub-btn');
        const visionBtn = document.querySelector('.chapter-nav__btn--expandable');

        if (chapterEls.length === 0 || chapterBtns.length === 0) return;

        const scrollTo = (target) => {
          if (!target) return;
          const headerH = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-height')) || 56;
          const top = target.getBoundingClientRect().top + window.scrollY - headerH - 80;
          window.scrollTo({ top, behavior: 'smooth' });
        };

        let activeChapter = '';

        const setActiveChapter = (id) => {
          if (id === activeChapter) return;
          activeChapter = id;
          chapterBtns.forEach((btn) => {
            const isActive = btn.dataset.target === id;
            btn.setAttribute('aria-current', isActive ? 'true' : 'false');
            if (btn.hasAttribute('aria-expanded')) {
              btn.setAttribute('aria-expanded', isActive ? 'true' : 'false');
            }
          });
        };

        const setActiveSubStage = (idx) => {
          subBtns.forEach((btn, i) => {
            btn.setAttribute('aria-current', i === idx ? 'true' : 'false');
          });
        };

        // Chapter-level observer
        const chapterObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting && entry.target.id) {
                setActiveChapter(entry.target.id);
              }
            });
          },
          { rootMargin: '-20% 0px -60% 0px', threshold: 0 }
        );
        chapterEls.forEach((el) => chapterObserver.observe(el));

        // Sub-stage observer (Vision stages 1–4)
        if (subStages.length > 0) {
          const subObserver = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  const idx = parseInt(entry.target.dataset.stage, 10) - 1;
                  if (!isNaN(idx)) setActiveSubStage(idx);
                }
              });
            },
            { rootMargin: '-20% 0px -60% 0px', threshold: 0 }
          );
          subStages.forEach((s) => subObserver.observe(s));
        }

        // Click handlers — chapter buttons
        chapterBtns.forEach((btn) => {
          btn.addEventListener('click', () => scrollTo(document.getElementById(btn.dataset.target)));
        });

        // Click handlers — sub-stage buttons
        subBtns.forEach((btn) => {
          btn.addEventListener('click', () => scrollTo(document.getElementById(btn.dataset.target)));
        });

        // Initial state
        setActiveChapter('chapter-proof');
      }

      function initRevealAnimations() {
        const els = document.querySelectorAll('[data-reveal]');
        if (!els.length) return;

        // Respect reduced motion
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          els.forEach((el) => el.classList.add('revealed'));
          return;
        }

        const revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('revealed');
                revealObserver.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12 }
        );
        els.forEach((el) => revealObserver.observe(el));
      }

      // Shared CSS to strip site chrome from embedded iframes
      const embedChromeCSS = [
        // BaseLayout chrome
        'header.sticky', 'footer', '.feedback-widget-button', '.no-print',
        // ModuleLayout chrome
        'nav.mb-6.text-sm',                       // breadcrumb
        '.flex.flex-wrap.gap-3.mb-8.pb-6',        // action bar (PDF/Export)
        'nav.mt-12.pt-8.border-t',                // prev/next nav
        '.toc-sidebar:not(.toc-sidebar--mobile)',    // desktop TOC sidebar only (mobile drawer content kept)
        // Banners
        'body > astro-island',
      ].join(', ') + ' { display: none !important; } '
        + 'body { padding-top: 0 !important; } '
        + '.module-layout { display: block !important; } '
        + '.module-content { max-width: 100% !important; padding: 1rem !important; } '
        + '.toc-mobile-trigger { display: flex !important; } '
        + '.toc-mobile-backdrop { display: block !important; } '
        + '.toc-mobile-drawer { display: flex !important; }';

      function injectEmbedCSS(iframe) {
        const inject = () => {
          try {
            const doc = iframe.contentDocument;
            if (!doc) return;
            if (doc.querySelector('[data-embed-injected]')) return;
            const style = doc.createElement('style');
            style.textContent = embedChromeCSS;
            style.setAttribute('data-embed-injected', '');
            doc.head.appendChild(style);
          } catch (e) { /* cross-origin guard */ }
        };
        iframe.addEventListener('load', inject);
        if (iframe.contentDocument?.readyState === 'complete') inject();
      }

      function initDashboardDialog() {
        const openBtn = document.querySelector('[data-dashboard-open]');
        const dialog = document.querySelector('[data-dashboard-dialog]');
        const closeBtn = dialog?.querySelector('[data-dashboard-close]');
        if (!openBtn || !dialog || typeof dialog.showModal !== 'function') return;

        const lockScroll = () => { document.body.style.overflow = 'hidden'; };
        const unlockScroll = () => { document.body.style.overflow = ''; };

        openBtn.addEventListener('click', () => { dialog.showModal(); lockScroll(); });
        closeBtn?.addEventListener('click', () => { dialog.close(); unlockScroll(); });
        dialog.addEventListener('click', (e) => {
          if (e.target === dialog) { dialog.close(); unlockScroll(); }
        });
        dialog.addEventListener('close', unlockScroll);

        // Inject embed CSS into dashboard iframes
        document.querySelectorAll('iframe[src*="/dashboard"]').forEach(injectEmbedCSS);
      }

      function initModuleDialogs() {
        // Inject embed CSS into inline module iframes
        document.querySelectorAll('.module-embed__frame').forEach(injectEmbedCSS);

        // Lock/unlock body scroll when dialogs open/close
        const lockScroll = () => { document.body.style.overflow = 'hidden'; };
        const unlockScroll = () => { document.body.style.overflow = ''; };

        // Open buttons
        document.querySelectorAll('[data-module-open]').forEach((btn) => {
          const id = btn.dataset.moduleOpen;
          const dialog = document.querySelector('[data-module-dialog="' + id + '"]');
          if (!dialog || typeof dialog.showModal !== 'function') return;
          btn.addEventListener('click', () => {
            // Lazy-load dialog iframe on first open
            const iframe = dialog.querySelector('iframe[data-src]');
            if (iframe && !iframe.src) {
              iframe.src = iframe.dataset.src;
              injectEmbedCSS(iframe);
            }
            dialog.showModal();
            lockScroll();
          });
        });

        // Close buttons
        document.querySelectorAll('[data-module-close]').forEach((btn) => {
          const id = btn.dataset.moduleClose;
          const dialog = document.querySelector('[data-module-dialog="' + id + '"]');
          if (!dialog) return;
          btn.addEventListener('click', () => { dialog.close(); unlockScroll(); });
        });

        // Backdrop click to close + restore scroll on any close (Escape key, etc.)
        document.querySelectorAll('.module-dialog').forEach((dialog) => {
          dialog.addEventListener('click', (e) => {
            if (e.target === dialog) { dialog.close(); unlockScroll(); }
          });
          dialog.addEventListener('close', unlockScroll);
        });
      }

      function initTierSwitcher() {
        const tabs = document.querySelectorAll('.tier-switcher__tab');
        const panels = document.querySelectorAll('.tier-panel');
        if (!tabs.length || !panels.length) return;

        tabs.forEach((tab) => {
          tab.addEventListener('click', () => {
            const tier = tab.dataset.tier;

            // Update tabs
            tabs.forEach((t) => {
              const isActive = t.dataset.tier === tier;
              t.classList.toggle('tier-switcher__tab--active', isActive);
              t.setAttribute('aria-selected', isActive ? 'true' : 'false');
            });

            // Update panels
            panels.forEach((p) => {
              const isActive = p.id === 'tier-' + tier;
              p.classList.toggle('tier-panel--active', isActive);
              p.hidden = !isActive;
            });

            // Trigger reveal animations on newly visible panel elements
            const activePanel = document.getElementById('tier-' + tier);
            if (activePanel) {
              activePanel.querySelectorAll('[data-reveal]:not(.revealed)').forEach((el) => {
                el.classList.add('revealed');
              });
            }
          });
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init, { once: true });
      } else {
        init();
      }
    })();
  </script>

