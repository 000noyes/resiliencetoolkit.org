---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Badge from '@/components/Badge.astro';
---

<BaseLayout
  title="Proposal | Resilience Toolkit"
  description="Learning Journey & Interface Workflow Development proposal."
>
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <meta slot="head" name="googlebot" content="noindex, nofollow" />

  <!-- ╔═══════════════════════════════════════╗ -->
  <!-- ║         PASSWORD GATE                 ║ -->
  <!-- ╚═══════════════════════════════════════╝ -->
  <div id="password-gate" class="password-gate">
    <div class="password-gate__card">
      <h1 class="text-title font-semibold text-foreground mb-2 text-center">
        This page is protected
      </h1>
      <p class="text-body-small text-muted-foreground mb-6 text-center">
        Enter the password to view this proposal.
      </p>
      <form id="password-form" class="space-y-4">
        <div>
          <label for="password-input" class="sr-only">Password</label>
          <input
            id="password-input"
            type="password"
            placeholder="Password"
            autocomplete="off"
            class="password-gate__input"
          />
        </div>
        <button
          type="submit"
          class="password-gate__submit"
        >
          View Proposal
        </button>
        <p id="password-error" class="hidden text-body-small text-destructive text-center" aria-live="polite">
          Incorrect password. Please try again.
        </p>
      </form>
    </div>
  </div>

  <!-- ╔═══════════════════════════════════════╗ -->
  <!-- ║         PROPOSAL CONTENT              ║ -->
  <!-- ╚═══════════════════════════════════════╝ -->
  <article id="proposal-content" class="hidden">

    <!-- Chapter Nav (tracks proposal sections + Vision sub-stages) -->
    <nav class="chapter-nav" aria-label="Proposal sections">
      <div class="container mx-auto px-4 max-w-5xl">
        <ol class="chapter-nav__list">
          <li>
            <button class="chapter-nav__btn" data-target="chapter-proof" data-chapter="proof" aria-current="true">
              <span class="chapter-nav__indicator"></span>
              <span class="chapter-nav__label">Proof</span>
            </button>
          </li>
          <li class="chapter-nav__vision-group">
            <button class="chapter-nav__btn chapter-nav__btn--expandable" data-target="chapter-vision" data-chapter="vision" aria-current="false" aria-expanded="false">
              <span class="chapter-nav__indicator"></span>
              <span class="chapter-nav__label">Vision</span>
            </button>
            <ol class="chapter-nav__sub">
              <li><button class="chapter-nav__sub-btn" data-target="stage-foundation" aria-current="false">1</button></li>
              <li><button class="chapter-nav__sub-btn" data-target="stage-relationships" aria-current="false">2</button></li>
              <li><button class="chapter-nav__sub-btn" data-target="stage-preparedness" aria-current="false">3</button></li>
              <li><button class="chapter-nav__sub-btn" data-target="stage-systems" aria-current="false">4</button></li>
            </ol>
          </li>
          <li>
            <button class="chapter-nav__btn" data-target="chapter-process" data-chapter="process" aria-current="false">
              <span class="chapter-nav__indicator"></span>
              <span class="chapter-nav__label">Process</span>
            </button>
          </li>
          <li>
            <button class="chapter-nav__btn" data-target="chapter-scope" data-chapter="scope" aria-current="false">
              <span class="chapter-nav__indicator"></span>
              <span class="chapter-nav__label">Scope</span>
            </button>
          </li>
        </ol>
      </div>
    </nav>

    <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
    <!--               OPENING                 -->
    <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
    <section class="py-16 border-b border-border" id="chapter-proof">
      <div class="container mx-auto px-4 max-w-4xl">
        <div class="mb-4">
          <Badge variant="primary">Proposal</Badge>
        </div>
        <p class="text-body-small text-muted-foreground uppercase tracking-widest mb-2">
          Access Ecologies / Rhizome
        </p>
        <h1 class="text-hero font-semibold text-foreground mb-2">
          Learning Journey &amp; Interface Workflow Development
        </h1>
        <p class="text-title text-primary font-medium mb-4">
          $5,600 – $12,000
        </p>
        <p class="text-body text-muted-foreground mb-8">
          Two scopes aligned to CROs' $50K and $77K Resilience Hub Toolkit stewardship and assessment proposal. 
        </p>
        <div class="space-y-4 max-w-3xl">
          <p class="text-body-large text-muted-foreground leading-relaxed">
            <strong class="text-foreground">Objective:</strong> Design and implement clear, role-based learning journeys and interface workflows that help people understand what applies to them, where they are in the process, and what to do next when using ResilienceToolkit.org.
          </p>
          <p class="text-body text-muted-foreground">
            This work converts live technical assistance and organizing knowledge into durable, navigable digital infrastructure.
          </p>
        </div>

        <!-- SOW Context -->
        <div class="space-y-4 max-w-3xl mt-8 pt-8 border-t border-border">
          <p class="text-body-large text-muted-foreground leading-relaxed">
            The <strong class="text-foreground">Resilience Hub Toolkit Cohort</strong> is composed of grassroots responders to flooding, community caretakers, and experienced facilitators and problem-solvers. Community Resilience Organizations (CROs), founded in 2011 after Hurricane Irene, convened this cohort in 2024 after two years of catastrophic flooding. Together, we created the Resilience Hub Toolkit — available in online/offline formats at resiliencetoolkit.org.
          </p>
          <p class="text-body text-muted-foreground">
            Access Ecologies' interface work is one component of the cohort's broader scope: connecting the Toolkit to existing emergency systems, supporting implementation across Vermont communities, assessing efficacy, and concluding the first year of implementation with a clear proof of concept.
          </p>
          <p class="text-body text-foreground font-medium mt-6">
            Before we describe what's next, here's what already exists.
          </p>
        </div>
      </div>
    </section>

    <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
    <!--               PROOF                   -->
    <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->

    <!-- Analytics -->
    <section class="py-12 bg-muted">
      <div class="container mx-auto px-4 max-w-4xl">
        <h2 class="text-headline font-semibold text-foreground mb-6">
          Current Traction
        </h2>
        <div class="proof-card" data-reveal>
          <figure>
            <img
              src="/other/umami-90days-feb10.png"
              alt="Analytics dashboard showing 7.29k views, 2.27k visitors, 2.92k visits, and 1m 45s average visit duration over 90 days"
              class="w-full rounded-lg border border-border"
              loading="lazy"
              decoding="async"
            />
            <figcaption class="mt-4 text-center">
              <p class="text-body-large font-semibold text-foreground mb-1">
                <span class="text-primary">7,290 views</span> ·
                <span class="text-primary">2,270 visitors</span> ·
                <span class="text-primary">1m 45s</span> avg. visit
              </p>
              <p class="text-body-small text-muted-foreground">
                90-day analytics from ResilienceToolkit.org — steady organic engagement
              </p>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- Infrastructure Grid -->
    <section class="py-12">
      <div class="container mx-auto px-4 max-w-4xl">
        <h2 class="text-headline font-semibold text-foreground mb-3">
          What's Already Built
        </h2>
        <p class="text-body text-muted-foreground mb-8 max-w-2xl">
          ResilienceToolkit.org has moved from concept to fully deployed, production-ready infrastructure. Learning journeys are the next layer that builds on this foundation.
        </p>
        <div class="infra-grid">
          <div class="infra-card" data-reveal>
            <h3 class="infra-card__title">17 Interactive Sections</h3>
            <p class="infra-card__desc">Checklists, worksheets, and guides across 3 modules — all saving progress locally in the browser.</p>
          </div>
          <div class="infra-card" data-reveal data-reveal-delay="100">
            <h3 class="infra-card__title">Local-First Architecture</h3>
            <p class="infra-card__desc">IndexedDB storage. No accounts, no data collection, no servers. Works offline. Data never leaves the device.</p>
          </div>
          <div class="infra-card" data-reveal data-reveal-delay="200">
            <h3 class="infra-card__title">Personal Dashboard</h3>
            <p class="infra-card__desc">Streak tracking, weekly goals, activity feeds, module-by-module progress breakdown, one-click data export.</p>
          </div>
          <div class="infra-card" data-reveal data-reveal-delay="300">
            <h3 class="infra-card__title">Open &amp; Print-Ready</h3>
            <p class="infra-card__desc">MIT-licensed code, CC-licensed content. PDF export, dark mode, mobile-optimized, accessible.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Live Dashboard Embed -->
    <section class="py-12 bg-muted">
      <div class="container mx-auto px-4 max-w-5xl">
        <div class="dashboard-embed" data-reveal>
          <div class="dashboard-embed__header">
            <span class="dashboard-embed__label">Live Dashboard</span>
            <button
              type="button"
              class="dashboard-embed__expand"
              data-dashboard-open
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M9 21H3v-6"/><path d="M21 3l-7 7"/><path d="M3 21l7-7"/></svg>
              Open full view
            </button>
          </div>
          <iframe
            src="/dashboard"
            class="dashboard-embed__frame"
            title="Resilience Toolkit Dashboard — live interactive embed"
            loading="lazy"
          ></iframe>
          <div class="dashboard-embed__caption">
            <p class="text-body text-muted-foreground">
              Progress tracking, streak goals, activity feeds, data export. This is the foundation learning journeys build on.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Dashboard Fullscreen Dialog -->
    <dialog class="dashboard-dialog" data-dashboard-dialog>
      <div class="dashboard-dialog__chrome">
        <div class="dashboard-dialog__header">
          <span class="dashboard-embed__label">Live Dashboard</span>
          <button
            type="button"
            class="dashboard-dialog__close"
            data-dashboard-close
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
            Close
          </button>
        </div>
        <iframe
          src="/dashboard"
          class="dashboard-dialog__frame"
          title="Resilience Toolkit Dashboard — fullscreen view"
          loading="lazy"
        ></iframe>
      </div>
    </dialog>

    <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
    <!--               VISION                  -->
    <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->

    <!-- Vision Narrative Intro -->
    <section class="py-16" id="chapter-vision">
      <div class="container mx-auto px-4 max-w-3xl">
        <div class="mb-4">
          <Badge variant="info">Vision</Badge>
        </div>
        <h2 class="text-headline font-semibold text-foreground mb-6">
          From Collection to Pathway
        </h2>
        <div class="space-y-4">
          <p class="text-body-large text-muted-foreground leading-relaxed">
            Right now, everyone who arrives at the toolkit sees the same thing. A new community organizer, a seasoned mutual aid coordinator, and a town emergency manager all land on the same page with the same 17 sections.
          </p>
          <p class="text-body-large text-foreground leading-relaxed font-medium">
            Learning journeys change that.
          </p>
          <p class="text-body text-muted-foreground">
            Each person sees a path shaped for their role — sequential, clear, and grounded in what real organizers actually need to learn first. Below is an example: the <strong class="text-foreground">New Community Organizer</strong> journey.
          </p>
        </div>
      </div>
    </section>

    <!-- JOURNEY STAGE 1: Foundation -->
    <section class="journey-stage py-16 bg-muted" id="stage-foundation" data-stage="1">
      <div class="container mx-auto px-4 max-w-5xl">
        <header class="journey-stage__header">
          <span class="journey-stage__badge">Stage 1</span>
          <h2 class="journey-stage__title">Foundation</h2>
          <p class="journey-stage__description">
            Understanding the toolkit and mapping your community.
          </p>
        </header>
        <div class="journey-stage__cards">
          <div class="module-embed" data-reveal>
            <div class="module-embed__header">
              <div class="module-embed__meta">
                <span class="journey-card__number">0.0</span>
                <span class="journey-card__phase journey-card__phase--before">Before</span>
              </div>
              <div class="module-embed__actions">
                <a href="/introduction" class="module-embed__link">Open full page</a>
                <button type="button" class="module-embed__expand" data-module-open="intro">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M9 21H3v-6"/><path d="M21 3l-7 7"/><path d="M3 21l7-7"/></svg>
                  Expand
                </button>
              </div>
            </div>
            <h3 class="module-embed__title">Introduction</h3>
            <p class="module-embed__desc">What this toolkit is for, what resilience means, and how to use it</p>
            <iframe
              src="/introduction"
              class="module-embed__frame"
              title="Introduction — live interactive embed"
              loading="lazy"
            ></iframe>
          </div>
          <div class="module-embed" data-reveal data-reveal-delay="100">
            <div class="module-embed__header">
              <div class="module-embed__meta">
                <span class="journey-card__number">0.1</span>
                <span class="journey-card__phase journey-card__phase--before">Before · After</span>
              </div>
              <div class="module-embed__actions">
                <a href="/modules/knowing-your-community" class="module-embed__link">Open full page</a>
                <button type="button" class="module-embed__expand" data-module-open="kyc">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M9 21H3v-6"/><path d="M21 3l-7 7"/><path d="M3 21l7-7"/></svg>
                  Expand
                </button>
              </div>
            </div>
            <h3 class="module-embed__title">Knowing Your Community</h3>
            <p class="module-embed__desc">Map your community, identify key people, and find the work you want to do</p>
            <iframe
              src="/modules/knowing-your-community"
              class="module-embed__frame"
              title="Knowing Your Community — live interactive embed"
              loading="lazy"
            ></iframe>
          </div>
        </div>
        <div class="journey-stage__connector" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
        </div>
      </div>
    </section>

    <!-- JOURNEY STAGE 2: Relationships -->
    <section class="journey-stage py-16" id="stage-relationships" data-stage="2">
      <div class="container mx-auto px-4 max-w-5xl">
        <header class="journey-stage__header">
          <span class="journey-stage__badge">Stage 2</span>
          <h2 class="journey-stage__title">Relationships</h2>
          <p class="journey-stage__description">
            Building mutual aid networks and connecting with existing community structures.
          </p>
        </header>
        <div class="journey-stage__cards">
          <div class="module-embed" data-reveal>
            <div class="module-embed__header">
              <div class="module-embed__meta">
                <span class="journey-card__number">1.12</span>
                <span class="journey-card__phase journey-card__phase--during">Before · During · After</span>
              </div>
              <div class="module-embed__actions">
                <a href="/modules/emergency-preparedness/1-12" class="module-embed__link">Open full page</a>
                <button type="button" class="module-embed__expand" data-module-open="mutual-aid">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M9 21H3v-6"/><path d="M21 3l-7 7"/><path d="M3 21l7-7"/></svg>
                  Expand
                </button>
              </div>
            </div>
            <h3 class="module-embed__title">Mutual Aid / Neighbor to Neighbor</h3>
            <p class="module-embed__desc">Solidarity-based networks, low-barrier access to help, and community-led response</p>
            <iframe
              src="/modules/emergency-preparedness/1-12"
              class="module-embed__frame"
              title="Mutual Aid / Neighbor to Neighbor — live interactive embed"
              loading="lazy"
            ></iframe>
          </div>
          <div class="module-embed" data-reveal data-reveal-delay="100">
            <div class="module-embed__header">
              <div class="module-embed__meta">
                <span class="journey-card__number">2.3</span>
                <span class="journey-card__phase journey-card__phase--before">Before · After</span>
              </div>
              <div class="module-embed__actions">
                <a href="/modules/baseline-resilience/2-3" class="module-embed__link">Open full page</a>
                <button type="button" class="module-embed__expand" data-module-open="community-building">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M9 21H3v-6"/><path d="M21 3l-7 7"/><path d="M3 21l7-7"/></svg>
                  Expand
                </button>
              </div>
            </div>
            <h3 class="module-embed__title">Community Building</h3>
            <p class="module-embed__desc">Connecting resilience hubs, local governance, and regional coordination</p>
            <iframe
              src="/modules/baseline-resilience/2-3"
              class="module-embed__frame"
              title="Community Building — live interactive embed"
              loading="lazy"
            ></iframe>
          </div>
        </div>
        <div class="journey-stage__connector" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
        </div>
      </div>
    </section>

    <!-- JOURNEY STAGE 3: Preparedness -->
    <section class="journey-stage py-16 bg-muted" id="stage-preparedness" data-stage="3">
      <div class="container mx-auto px-4 max-w-5xl">
        <header class="journey-stage__header">
          <span class="journey-stage__badge">Stage 3</span>
          <h2 class="journey-stage__title">Preparedness</h2>
          <p class="journey-stage__description">
            Core emergency knowledge — from personal readiness to inclusive community plans.
          </p>
        </header>
        <div class="journey-stage__cards">
          <div class="module-embed" data-reveal>
            <div class="module-embed__header">
              <div class="module-embed__meta">
                <span class="journey-card__number">1.1</span>
                <span class="journey-card__phase journey-card__phase--before">Before</span>
              </div>
              <div class="module-embed__actions">
                <a href="/modules/emergency-preparedness/1-1" class="module-embed__link">Open full page</a>
                <button type="button" class="module-embed__expand" data-module-open="ep-kits">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M9 21H3v-6"/><path d="M21 3l-7 7"/><path d="M3 21l7-7"/></svg>
                  Expand
                </button>
              </div>
            </div>
            <h3 class="module-embed__title">Emergency Preparedness Kits</h3>
            <p class="module-embed__desc">Household emergency supplies, go-bags, and evacuation essentials</p>
            <iframe
              src="/modules/emergency-preparedness/1-1"
              class="module-embed__frame"
              title="Emergency Preparedness Kits — live interactive embed"
              loading="lazy"
            ></iframe>
          </div>
          <div class="module-embed" data-reveal data-reveal-delay="100">
            <div class="module-embed__header">
              <div class="module-embed__meta">
                <span class="journey-card__number">1.9</span>
                <span class="journey-card__phase journey-card__phase--during">Before · During</span>
              </div>
              <div class="module-embed__actions">
                <a href="/modules/emergency-preparedness/1-9" class="module-embed__link">Open full page</a>
                <button type="button" class="module-embed__expand" data-module-open="cerp">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M9 21H3v-6"/><path d="M21 3l-7 7"/><path d="M3 21l7-7"/></svg>
                  Expand
                </button>
              </div>
            </div>
            <h3 class="module-embed__title">Community Emergency Response Plans</h3>
            <p class="module-embed__desc">Emergency directories, communication systems, phone trees, and situation reports</p>
            <iframe
              src="/modules/emergency-preparedness/1-9"
              class="module-embed__frame"
              title="Community Emergency Response Plans — live interactive embed"
              loading="lazy"
            ></iframe>
          </div>
          <div class="module-embed" data-reveal data-reveal-delay="200">
            <div class="module-embed__header">
              <div class="module-embed__meta">
                <span class="journey-card__number">1.8</span>
                <span class="journey-card__phase journey-card__phase--during">Before · During · After</span>
              </div>
              <div class="module-embed__actions">
                <a href="/modules/emergency-preparedness/1-8" class="module-embed__link">Open full page</a>
                <button type="button" class="module-embed__expand" data-module-open="specific-needs">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M9 21H3v-6"/><path d="M21 3l-7 7"/><path d="M3 21l7-7"/></svg>
                  Expand
                </button>
              </div>
            </div>
            <h3 class="module-embed__title">Populations with Specific Needs</h3>
            <p class="module-embed__desc">Inclusive planning for children, elderly, disabled, and medically fragile community members</p>
            <iframe
              src="/modules/emergency-preparedness/1-8"
              class="module-embed__frame"
              title="Populations with Specific Needs — live interactive embed"
              loading="lazy"
            ></iframe>
          </div>
        </div>
        <div class="journey-stage__connector" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
        </div>
      </div>
    </section>

    <!-- JOURNEY STAGE 4: Systems -->
    <section class="journey-stage py-16" id="stage-systems" data-stage="4">
