---
/**
 * Dashboard Page - Local-Only App
 *
 * One question first: is my work safe? The safety zone leads (state sentence,
 * receipt, one button, the honest meter), then restore, then a quiet secondary
 * column. With no saved work the page is a single centered column (no rail, no
 * canyon) that teaches the one thing; with work it becomes two columns and the
 * rail carries progress, notes, and links.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import BackupSafetyCard from '../components/BackupSafetyCard';
import RestoreBackupZone from '../components/RestoreBackupZone';
import WorkProgress from '../components/WorkProgress';
import PersonalNotes from '../components/PersonalNotes';
import { BookOpen, Download } from 'lucide-react';

const eyebrow = 'text-sm font-medium uppercase tracking-wide text-muted-foreground';
---

<BaseLayout title="Dashboard - Resilience Hub Toolkit">
  <div class="bg-background min-h-screen">
    <div id="dash" data-work="empty" class="mx-auto w-full px-4 sm:px-6 lg:px-8 py-8 pb-28">
      <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">Dashboard</p>

      <div class="dash-grid mt-6">
        <!-- MAIN COLUMN: the answer -->
        <div class="dash-main flex flex-col gap-10">
          <section id="backup" class="scroll-mt-24" aria-label="Backup status">
            <BackupSafetyCard client:load />
          </section>

          <!-- STARTER: shown only with no saved work (single column, no canyon) -->
          <section class="dash-starter" aria-label="Start with a module">
            <h2 class={eyebrow}>Start with a module</h2>
            <ul class="mt-3 rounded-lg border border-border bg-card divide-y divide-border">
              <li>
                <a href="/modules/knowing-your-community" class="block px-4 py-3 hover:bg-muted transition-colors no-underline group">
                  <span class="block text-sm font-medium text-foreground group-hover:text-primary transition-colors">Knowing Your Community</span>
                  <span class="block text-xs text-muted-foreground">Map your local resources and connections</span>
                </a>
              </li>
              <li>
                <a href="/modules/emergency-preparedness" class="block px-4 py-3 hover:bg-muted transition-colors no-underline group">
                  <span class="block text-sm font-medium text-foreground group-hover:text-primary transition-colors">Emergency Preparedness</span>
                  <span class="block text-xs text-muted-foreground">Build your household emergency kit</span>
                </a>
              </li>
              <li>
                <a href="/modules/baseline-resilience" class="block px-4 py-3 hover:bg-muted transition-colors no-underline group">
                  <span class="block text-sm font-medium text-foreground group-hover:text-primary transition-colors">Baseline Resilience</span>
                  <span class="block text-xs text-muted-foreground">Assess and improve community readiness</span>
                </a>
              </li>
            </ul>
          </section>

          <!-- RESTORE -->
          <section id="restore" class="scroll-mt-24" aria-label="Restore a backup">
            <h2 class={eyebrow}>Restore a backup</h2>
            <p class="mt-2 text-sm text-muted-foreground max-w-prose">
              See what a backup holds before you restore it.
            </p>
            <div class="mt-4">
              <RestoreBackupZone client:load />
            </div>
          </section>
        </div>

        <!-- SECONDARY COLUMN: quiet, shown only when there is saved work -->
        <aside class="dash-rail flex-col gap-6">
          <WorkProgress client:load />
          <div class="border-t border-border"></div>
          <PersonalNotes client:load />
          <div class="border-t border-border"></div>
          <section aria-label="Links">
            <h2 class={eyebrow}>Links</h2>
            <nav class="mt-3 space-y-1">
              <a href="/downloads" class="flex items-center gap-2 py-1 text-sm text-foreground hover:text-primary transition-colors no-underline">
                <Download className="w-4 h-4 text-muted-foreground" />
                Downloads
              </a>
              <a href="/about" class="flex items-center gap-2 py-1 text-sm text-foreground hover:text-primary transition-colors no-underline">
                <BookOpen className="w-4 h-4 text-muted-foreground" />
                About the toolkit
              </a>
            </nav>
          </section>
        </aside>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      try {
        var raw = localStorage.getItem('rt-has-work');
        if (!raw) return;
        var c = JSON.parse(raw);
        if (c && c.modules && Object.keys(c.modules).some(function (k) { return c.modules[k]; })) {
          var el = document.getElementById('dash');
          if (el) el.dataset.work = 'has';
        }
      } catch (e) {}
    })();
  </script>

  <style is:global>
    /* Work-state layout switch. Default (and JS-off) is the single-column empty
       layout: the answer, a quiet starter list, and restore in one centered
       column, so there is never a rail-shaped void. The has-work state widens
       to two columns and reveals the rail. WorkProgress sets #dash[data-work]
       authoritatively after reading storage; the inline script above sets an
       early guess from the has-work canary to avoid a layout flash. */
    #dash { max-width: 42rem; }
    #dash[data-work="has"] { max-width: 80rem; }

    #dash .dash-grid { display: block; }
    #dash .dash-rail { display: none; }
    #dash .dash-starter { display: block; }

    #dash[data-work="has"] .dash-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }
    @media (min-width: 1024px) {
      #dash[data-work="has"] .dash-grid {
        grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      }
    }
    #dash[data-work="has"] .dash-rail { display: flex; }
    #dash[data-work="has"] .dash-starter { display: none; }

    /* The backup button owns the filled action color on this page; the feedback
       trigger must never overlap a control at 1280 or 390, so it leaves the
       fixed layer entirely: a quiet outline block in the flow after the footer. */
    .feedback-widget-button {
      position: static;
      display: inline-flex;
      margin: 1.25rem auto 2rem;
      background-color: var(--card);
      color: var(--muted-foreground);
      border: 1px solid var(--border);
      box-shadow: none;
    }
    .feedback-widget-button:hover {
      color: var(--foreground);
      transform: none;
    }
  </style>
</BaseLayout>
