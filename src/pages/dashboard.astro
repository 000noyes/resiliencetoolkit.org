---
/**
 * Dashboard Page - Local-Only App
 *
 * The page answers one question first: is my work safe? Three zones in
 * priority order: the safety zone (state sentence, receipt, one button, the
 * honest meter), then restore, then everything else demoted to the secondary
 * column. The page header is an eyebrow so the state sentence owns the first
 * fixation.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import UserProgressDashboard from '../components/UserProgressDashboard';
import PersonalNotes from '../components/PersonalNotes';
import BackupSafetyCard from '../components/BackupSafetyCard';
import ImportDataButton from '../components/ImportDataButton';
import WhatsNewCard from '../components/WhatsNewCard';
import { BookOpen, Download, FolderOpen } from 'lucide-react';
---

<BaseLayout title="Dashboard - Resilience Hub Toolkit">
  <div class="bg-gray-50 dark:bg-gray-900 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 pb-28">
      <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">Dashboard</p>

      <div class="mt-6 grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- MAIN COLUMN: the answer -->
        <div class="lg:col-span-2 flex flex-col gap-10">
          <!-- SAFETY ZONE (zones 1 + 2) -->
          <section id="backup" class="scroll-mt-24" aria-label="Backup status">
            <BackupSafetyCard client:load />
          </section>

          <!-- RESTORE ZONE -->
          <section id="restore" class="scroll-mt-24" aria-label="Restore a backup">
            <h2 class="text-sm font-medium uppercase tracking-wide text-muted-foreground">
              Restore a backup
            </h2>
            <p class="mt-2 text-sm text-muted-foreground max-w-prose">
              Restoring reads your backup file and shows you what it holds before anything changes.
              It works with any backup made on this site, old or new.
            </p>
            <div
              class="mt-4 rounded-lg border border-border bg-card p-6 flex flex-col sm:flex-row items-center gap-4"
            >
              <FolderOpen
                className="h-6 w-6 text-muted-foreground flex-shrink-0"
                strokeWidth={1.5}
                aria-hidden="true"
              />
              <p class="flex-1 text-sm text-muted-foreground text-center sm:text-left">
                Pick the backup file from your Downloads, a drive, or wherever you keep it.
              </p>
              <div class="w-full sm:w-60">
                <ImportDataButton client:load />
              </div>
            </div>
            <details class="mt-3">
              <summary class="text-xs text-muted-foreground cursor-pointer">
                Used www.resiliencetoolkit.org before?
              </summary>
              <p class="mt-1 text-xs text-muted-foreground max-w-prose">
                Your work is safe. Open the www dashboard, tap Back up my work there, then restore
                the file here.
              </p>
            </details>
          </section>

          <!-- DEMOTED -->
          <WhatsNewCard client:load />
        </div>

        <!-- SECONDARY COLUMN -->
        <div class="flex flex-col gap-6">
          <UserProgressDashboard client:load />
          <PersonalNotes client:load />

          <!-- Quick Links -->
          <section
            class="bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 p-6"
          >
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Quick Links</h3>
            <nav class="space-y-2">
              <a
                href="/downloads"
                class="flex items-center gap-2 text-gray-700 dark:text-gray-300 hover:text-primary transition-colors"
              >
                <Download className="w-4 h-4" />
                Downloads
              </a>
              <a
                href="/about"
                class="flex items-center gap-2 text-gray-700 dark:text-gray-300 hover:text-primary transition-colors"
              >
                <BookOpen className="w-4 h-4" />
                About the Toolkit
              </a>
            </nav>
          </section>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style is:global>
  /* On this page the backup button owns the filled action color: the floating
     feedback trigger steps back to a neutral outline and must never overlap
     the backup controls (acceptance criterion at 1280 and 390; the page's
     bottom padding keeps scrolled-to-end controls clear of it). */
  .feedback-widget-button {
    background-color: var(--card);
    color: var(--muted-foreground);
    border: 1px solid var(--border);
    box-shadow: none;
  }
  .feedback-widget-button:hover {
    color: var(--foreground);
  }
</style>
