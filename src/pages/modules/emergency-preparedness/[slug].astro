---
/**
 * Dynamic Route for CMS-Managed Module Sections
 *
 * Renders MDX content from the 'sections' content collection using ModuleLayout.
 * Auto-computes navigation (prev/next) from the module's section order.
 *
 * This route coexists with static .astro pages during the phased migration.
 * Once all sections are migrated to MDX, the old .astro pages can be removed.
 */
import { getCollection, render } from 'astro:content';
import ModuleLayout from '@/layouts/ModuleLayout.astro';
import { getSectionNavigation } from '@/lib/navigation';

// Generate static paths for all sections in emergency-preparedness module
export async function getStaticPaths() {
  const allSections = await getCollection('sections');
  const epSections = allSections.filter(s => s.data.module === 'emergency-preparedness');

  return epSections.map(section => ({
    params: { slug: section.data.slug },
    props: { section },
  }));
}

const { section } = Astro.props;
const { Content } = await render(section);

// Auto-compute navigation from module section order
const sectionData = await getSectionNavigation(section.data.slug);
---

{sectionData && (
  <ModuleLayout sectionData={sectionData}>
    <Content />
  </ModuleLayout>
)}
