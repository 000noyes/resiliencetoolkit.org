---
/**
 * Dynamic Route for CMS-Managed Baseline Resilience Sections
 *
 * Renders MDX content from the 'sections' content collection using ModuleLayout.
 * Auto-computes navigation (prev/next) from the module's section order.
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ModuleLayout from '@/layouts/ModuleLayout.astro';
import { getSectionNavigation } from '@/lib/navigation';

export async function getStaticPaths() {
  const allSections = await getCollection('sections');
  const brSections = allSections.filter(s => s.data.module === 'baseline-resilience');

  return brSections.map(section => ({
    params: { slug: section.data.slug },
    props: { section },
  }));
}

const { section } = Astro.props;
const { Content } = await render(section);

const sectionData = await getSectionNavigation(section.data.slug);
---

{!sectionData ? (
  <BaseLayout title="Section not found">
    <div style="max-width: 640px; margin: 4rem auto; padding: 0 1rem; font-family: system-ui;">
      <h1>Section not found</h1>
      <p>This section could not be loaded. It may have moved or be temporarily unavailable.</p>
      <p>
        <a href="/modules">Back to modules</a> ·{' '}
        <a href="mailto:rhizome@accessecologies.com">Report this issue</a>
      </p>
    </div>
  </BaseLayout>
) : (
  <ModuleLayout sectionData={sectionData}>
    <Content />
  </ModuleLayout>
)}
