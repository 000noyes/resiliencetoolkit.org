---
import BaseLayout from '@/layouts/BaseLayout.astro';

const moduleData = {
  title: "Baseline Resilience",
  summary:
    "Build everyday resilience through shared resources, community care, and organizing practices that keep people safe before disaster strikes.",
  tags: ["baseline-resilience", "community"]
};

const sections = [
  { number: "2.1", title: "Basic Needs", slug: "2-1" },
  { number: "2.2", title: "Shared Tools", slug: "2-2" },
  { number: "2.3", title: "Community Building", slug: "2-3" }
];
---

<BaseLayout title={moduleData.title} description={moduleData.summary}>
  <article class="container mx-auto px-4 py-8 max-w-4xl">
    <!-- Breadcrumb navigation -->
    <nav class="mb-6 text-sm text-text-muted">
      <a href="/modules" class="hover:text-text-primary transition-colors">Modules</a>
      <span class="mx-2">/</span>
      <span class="text-text-primary">{moduleData.title}</span>
    </nav>

    <!-- Module header -->
    <header class="mb-8">
      <h1 class="text-display font-semibold mb-4">{moduleData.title}</h1>
      <p class="text-body-large text-text-secondary leading-relaxed">
        {moduleData.summary}
      </p>
      {moduleData.tags && (
        <div class="flex flex-wrap gap-2 mt-4">
          {moduleData.tags.map((tag) => (
            <span class="px-2 py-1 text-xs rounded bg-accent text-accent-foreground">
              #{tag}
            </span>
          ))}
        </div>
      )}
    </header>

    <!-- Section navigation grid -->
    <nav class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {sections.map((section) => (
        <a
          href={`/modules/baseline-resilience/${section.slug}`}
          class="group block p-6 bg-surface border border-border rounded-lg hover:border-table-accent hover:shadow-raised transition-all duration-base"
        >
          <span class="text-label text-table-accent font-semibold">
            {section.number}
          </span>
          <h2 class="text-subtitle font-medium mt-2 group-hover:text-table-accent transition-colors">
            {section.title}
          </h2>
        </a>
      ))}
    </nav>

    <!-- Back link -->
    <nav class="mt-12">
      <a
        href="/modules"
        class="inline-flex items-center text-text-secondary hover:text-text-primary transition-colors"
      >
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Back to All Modules
      </a>
    </nav>
  </article>
</BaseLayout>
