---
import BaseLayout from '@/layouts/BaseLayout.astro';
import OpenerSurface from '@/components/reading/OpenerSurface.astro';

const summary =
  'The material in this section builds on systems and stuff outlined in the Emergency Preparedness and Response section to deepen resilience in the day-to-day. Many people in our communities are in crisis all the time, and working towards a reality in which everyone is safe and has their needs met as a baseline means we can all be more resilient when acute disaster strikes.';
---

<BaseLayout title='Baseline Resilience' description={summary}>
  <OpenerSurface sectionSlug='baseline-resilience' summary={summary} />
</BaseLayout>
