---
import BaseLayout from '@/layouts/BaseLayout.astro';

// Offline fallback page. The service worker serves this whenever a
// navigation fails and the requested page is not in the cache. It is part
// of the worker's essential precache, so it is always available offline.
---

<BaseLayout
  title="Offline | Resilience Hub Toolkit"
  description="This page is not saved on this device yet. Pages already saved for offline use are listed here."
>
  <article class="container mx-auto px-4 py-12 max-w-2xl">
    <header class="mb-8">
      <h1 class="text-hero font-semibold mb-4 text-foreground">
        This page is not saved on this device yet
      </h1>
      <p class="text-body-large text-muted-foreground mb-3">
        You are offline right now, and the page you tried to open has not been
        saved for offline use. It will be saved automatically the next time you
        open it with a connection.
      </p>
      <p class="text-body-large text-muted-foreground">
        Everything below is already saved on this device and will open without
        a connection.
      </p>
    </header>

    <div class="mb-10 flex flex-wrap items-center gap-4">
      <button
        id="offline-retry"
        class="inline-flex items-center px-5 py-2.5 rounded-md bg-primary text-primary-foreground font-medium hover:opacity-90 transition-opacity"
      >
        Try again
      </button>
      <a href="/" class="text-primary font-medium hover:underline">
        Go to the home page
      </a>
    </div>

    <section aria-labelledby="saved-pages-heading">
      <h2 id="saved-pages-heading" class="text-xl font-semibold mb-4 text-foreground">
        Saved on this device
      </h2>
      <ul id="saved-pages" class="space-y-2"></ul>
      <p id="saved-pages-empty" class="text-muted-foreground hidden">
        No pages are saved yet. Open the toolkit once with a connection and it
        saves itself onto this device for offline use.
      </p>
    </section>
  </article>

  <script>
    document.getElementById('offline-retry')?.addEventListener('click', () => {
      window.location.reload();
    });

    // List every page route currently in the cache, labeled by its own
    // <title>, so people can see exactly what will open without a connection.
    async function listSavedPages() {
      const list = document.getElementById('saved-pages');
      const empty = document.getElementById('saved-pages-empty');
      if (!list || !('caches' in window)) return;

      const paths = new Set<string>();
      for (const name of await caches.keys()) {
        const cache = await caches.open(name);
        for (const req of await cache.keys()) {
          const path = new URL(req.url).pathname;
          if (path.endsWith('/') && path !== '/offline/') paths.add(path);
        }
      }

      const sorted = [...paths].sort();
      for (const path of sorted) {
        let label = path === '/' ? 'Home' : path;
        try {
          const res = await caches.match(path, { ignoreVary: true });
          if (res) {
            const html = await res.text();
            const match = html.match(/<title>([^<]*)<\/title>/i);
            if (match) {
              const cleaned = match[1].replace(/\s*\|\s*Resilience Hub Toolkit\s*$/i, '').trim();
              if (cleaned) label = cleaned;
            }
          }
        } catch {
          // Keep the pathname label if the cached page cannot be read.
        }
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = path;
        a.textContent = label;
        a.className = 'text-primary hover:underline';
        li.appendChild(a);
        list.appendChild(li);
      }

      if (!sorted.length && empty) empty.classList.remove('hidden');
    }

    listSavedPages();
  </script>
</BaseLayout>
