---
import '../styles/base.css';
import '@fontsource/outfit/400.css';
import '@fontsource/outfit/500.css';
import '@fontsource/outfit/600.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StatusBanner from '../components/StatusBanner.astro';
import BetaBanner from '../components/BetaBanner.tsx';
import StorageHealthBanner from '../components/StorageHealthBanner.tsx';
import UpdateBanner from '../components/UpdateBanner.tsx';
// Wrapper prevents Astro's renderer probe from triggering hook warnings.
import CornerPanelWrapper from '../components/CornerPanelWrapper.tsx';
import CornerPanel from '../components/CornerPanel.tsx';

interface Props {
  title?: string;
  description?: string;
  noPrint?: string[]; // Classes to hide when printing
  /**
   * 'interactive' (default) hydrates the corner panel; 'static-open' renders
   * it open and inert with no client JS (the workshop round page's proposal
   * under review); 'none' omits it.
   */
  panel?: 'interactive' | 'static-open' | 'none';
}

const {
  title = 'Resilience Hub Toolkit',
  description = 'Local-first tools to organize systems, stuff, and people before, during, and after disasters.',
  noPrint = [],
  panel = 'interactive',
} = Astro.props;

// Preserve `noPrint` for upcoming print layout work.
void noPrint;

const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const isPrintMode = Astro.url.searchParams.get('print') === '1';

// Workshop-copy build (the workshop.* project sets WORKSHOP=1): every page
// carries the strip naming what this copy is, plus meta robots noindex (the
// matching X-Robots-Tag header is appended postbuild). Production builds
// carry neither.
const isWorkshop = process.env.WORKSHOP === '1';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}

    <!-- Prevent FOUC (Flash of Unstyled Content) for dark mode -->
    <script is:inline>
      // This runs before page renders to prevent flash
      const theme = localStorage.getItem('theme') ||
        (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');

      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      }
    </script>

    <meta name="generator" content={Astro.generator} />
    {isWorkshop && <meta name="robots" content="noindex" />}

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/RHT_orange.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/icon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/icon-16x16.png" />

    <!-- Apple Touch Icon -->
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/icon-180x180.png" />

    <!-- PWA -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#8fd8c3" />

    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- Skip to content link for keyboard/screen reader users -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:px-4 focus:py-2 focus:bg-primary focus:text-primary-foreground focus:rounded-lg focus:shadow-lg focus:outline-none"
    >
      Skip to main content
    </a>

    {
      isWorkshop && !isPrintMode && (
        <div class="bg-muted border-y border-border" role="note">
          <div class="container mx-auto px-4 py-2.5">
            <p class="text-[13.5px] leading-snug text-foreground text-center" style="text-wrap: balance">
              This is the workshop copy of the toolkit. The finished site is{' '}
              <a
                href="https://resiliencetoolkit.org"
                class="underline underline-offset-2 hover:opacity-80 transition-opacity"
              >
                resiliencetoolkit.org</a
              >.
            </p>
          </div>
        </div>
      )
    }
    {!isPrintMode && <BetaBanner client:idle />}
    {!isPrintMode && <StorageHealthBanner client:idle />}
    {!isPrintMode && <UpdateBanner client:idle />}
    {!isPrintMode && !isWorkshop && <StatusBanner />}
    {!isPrintMode && <Header />}

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    {!isPrintMode && <Footer />}

    <!-- Corner panel (questions + fund doors) -->
    {/* Use wrapper so Astro's renderer-only invocation never runs hooks directly */}
    {!isPrintMode && panel === 'interactive' && <CornerPanelWrapper client:load />}
    {!isPrintMode && panel === 'static-open' && <CornerPanel staticOpen />}

    <script>
      import '@/lib/asset-rev'; // re-hash this entry chunk past the 2026-06-07 Cloudflare asset-poisoning incident
      // Keep CSS header height variable in sync with the rendered sticky header
      (() => {
        const root = document.documentElement;
        const headerSelector = 'header.sticky';

        const updateHeaderHeight = () => {
          const header = document.querySelector(headerSelector);
          if (!header) return;
          const { height } = header.getBoundingClientRect();
          if (height > 0) {
            root.style.setProperty('--header-height', `${Math.round(height)}px`);
          }
        };

        const init = () => {
          updateHeaderHeight();
          const header = document.querySelector(headerSelector);
          if (!header) return;
          if ('ResizeObserver' in window) {
            const resizeObserver = new ResizeObserver(updateHeaderHeight);
            resizeObserver.observe(header);
          }
          window.addEventListener('resize', updateHeaderHeight);
        };

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', init, { once: true });
        } else {
          init();
        }
      })();
    </script>

    <script>
      import { registerServiceWorker } from '@/lib/sw-register';

      registerServiceWorker();

      window.addEventListener('online', () => {
        document.dispatchEvent(new CustomEvent('network-status-change', {
          detail: { online: true }
        }));

        if ('serviceWorker' in navigator && navigator.serviceWorker.controller) {
          navigator.serviceWorker.controller.postMessage({ type: 'REGISTER_SYNC' });
        }
      });

      window.addEventListener('offline', () => {
        document.dispatchEvent(new CustomEvent('network-status-change', {
          detail: { online: false }
        }));
      });

      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.addEventListener('message', (event) => {
          if (event.data && event.data.type === 'SYNC_DATA') {
            document.dispatchEvent(new CustomEvent('background-sync', {
              detail: { timestamp: event.data.timestamp }
            }));
          }
        });
      }
    </script>

    <script>
      // Initialize local storage (no auth checks - app is fully local)
      import { initializeStorage, verifyStorage, exportAllData, getModuleTodos } from '@/lib/storage';
      import '@/lib/asset-rev'; // re-hash this entry chunk past the 2026-06-07 Cloudflare asset-poisoning incident

      // Run immediately (IIFE - Immediately Invoked Function Expression)
      (async () => {
        try {
          console.log('[BaseLayout] Initializing local storage (no auth)...');

          // Always initialize in local-only mode (also pre-warms IndexedDB)
          const { userId } = await initializeStorage();
          console.log('[BaseLayout] Initialized storage:', { userId });

          // Expose debug utilities on window for developer console access
          (window as any).debugStorage = {
            healthCheck: verifyStorage,
            async inspect(moduleKey: string) {
              const todos = await getModuleTodos(moduleKey);
              console.table(todos);
              return todos;
            },
            exportAll: exportAllData,
          };
        } catch (error) {
          console.error('[BaseLayout] Failed to initialize storage:', error);
        }
      })();

    </script>
  </body>
</html>
