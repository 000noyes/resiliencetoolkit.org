---
/**
 * ModuleLayout - Layout for module content pages
 *
 * This layout wraps BaseLayout and adds module-specific features:
 * - Section header with breadcrumb navigation
 * - Previous/Next section navigation
 * - Table of Contents sidebar (for section pages)
 * - Print and export functionality
 * - Module metadata display (tags, difficulty, time estimate)
 *
 * ## Dual-Mode Rendering:
 * Supports two content modes:
 * 1. **Frontmatter mode**: For MDX files with frontmatter metadata
 * 2. **Section mode**: For .astro section pages, which pass ONLY their
 *    printed section number; title, breadcrumb, prev/next, PDF, and
 *    resources all resolve from the one contents model (src/data/contents.ts)
 *
 * ## Navigation:
 * - Breadcrumb: Modules, Module, Section
 * - Prev/Next links between sections within a module
 * - "Back to Overview" link to the module opener
 * - The reading grammar (contents tree, On this page, Footnotes) through
 *   ReadingPage for section pages: the page header (breadcrumb, h1, the
 *   quiet action row) is its own grid child before the rail, so the
 *   phone reads title, On this page, body
 */
import BaseLayout from './BaseLayout.astro';
import { findChapter, chainFor, chapterCitation } from '@/data/contents';
import { getPdfUrlForSection } from '@/lib/pdfLookup';
import { getResourcesUrlForSection } from '@/lib/resourcesLookup';
import ExternalLink from '@/components/ExternalLink.astro';
import { FolderOpen } from 'lucide-react';
import ReadingPage from '@/components/reading/ReadingPage.astro';
import WorkLivesHere from '@/components/WorkLivesHere.tsx';
import ArticleBody from '@/components/reading/ArticleBody.astro';
import AnnotationIsland from '@/components/annotation/AnnotationIsland.tsx';

interface Props {
  frontmatter?: {
    title: string;
    order?: number;
    summary?: string;
    tags?: string[];
    phase?: 'Before' | 'During' | 'After';
    audience?: string[];
    time_to_complete?: string;
    difficulty?: 'Easy' | 'Medium' | 'Hard';
  };
  /** Printed section number, e.g. "1.2"; everything else resolves from the model */
  sectionNumber?: string;
  title?: string;
}

const { frontmatter, sectionNumber, title } = Astro.props;

const found = sectionNumber ? findChapter(sectionNumber) : null;
if (sectionNumber && !found) {
  throw new Error(`ModuleLayout: section ${sectionNumber} is not in the contents model`);
}
const sectionData = found
  ? {
      number: found.chapter.number,
      title: found.chapter.title,
      // Section 0 has no opener: its single chapter is its own module title
      moduleTitle: found.section.openerPath === null ? found.chapter.title : found.section.title,
      modulePath: found.section.basePath,
      ...chainFor(found.chapter.number),
    }
  : null;

// Look up PDF URL if we have section data
const pdfUrl = sectionData ? getPdfUrlForSection(sectionData.number) : null;
const resourcesUrl = sectionData ? getResourcesUrlForSection(sectionData.number) : null;

// Determine page title
const pageTitle = sectionData
  ? `${sectionData.number} ${sectionData.title} | ${sectionData.moduleTitle}`
  : frontmatter?.title || title || 'Module';

// Generate moduleKey for TOC progress tracking
const moduleKey = sectionData
  ? `${sectionData.modulePath?.split('/').pop() || 'module'}-${sectionData.number.replace('.', '-')}`
  : 'module';

// A workshop round renders this chapter at /rounds/<id>/ (the round page
// imports the chapter component): the strip, the Make Comments tenant,
// and the annotation island mount here, and the page leaves the search
// index. Nothing else about the page changes (the P6 seam).
const roundMatch = /^\/rounds\/([^/]+)\/?$/.exec(Astro.url.pathname);
const roundId = roundMatch ? roundMatch[1] : null;

// The page-level citation (DR17): a static in-flow line so print and
// no-JS readers keep their provenance (ER7); the Footnotes tenant
// presents the same string from the same field. Null until the chapter's
// printed range is operator-confirmed.
const citation = sectionData ? chapterCitation(sectionData.number) : null;

// A section page renders its body once inside ReadingPage (the heading
// and block id passes, On this page seeded from the result). The
// frontmatter mode has no reading grammar and renders the body here.
const looseHtml = sectionData ? '' : await Astro.slots.render('default');
---

<BaseLayout title={pageTitle} description={frontmatter?.summary}>
  {roundId && <div id="round-status-slot" data-annot-ui></div>}
  {sectionData ? (
    <ReadingPage
      currentPath={Astro.url.pathname}
      moduleKey={moduleKey}
      sectionNumber={sectionData.number}
      blockKey={sectionData.number.replace('.', '-')}
      comments={!!roundId}
      resting={roundId ? "make-comments" : "on-this-page"}
      indexed={!roundId}
    >
      <Fragment slot="header">
        <!-- Breadcrumb navigation for section pages -->
        <nav class="mb-6 text-sm text-text-muted no-print" data-pagefind-ignore>
          <a href="/modules" class="hover:text-text-primary transition-colors">Modules</a>
          <span class="mx-2">/</span>
          <a href={sectionData.modulePath || "/modules"} class="hover:text-text-primary transition-colors">
            {sectionData.moduleTitle}
          </a>
          <span class="mx-2">/</span>
          <span class="text-text-primary">{sectionData.number}</span>
        </nav>

        <div class="mb-8">
          <h1 class="text-hero font-semibold mb-2" data-pagefind-meta="title">
            {sectionData.number} {sectionData.title}
          </h1>
        </div>

        <!-- The chapter actions in the quiet grammar (DR21, 4A): one inline
             row of two text links, icon and label, left-aligned -->
        <div class="reading-actions no-print" data-pagefind-ignore>
          {pdfUrl ? (
            <a href={pdfUrl} target="_blank" rel="noopener noreferrer" class="reading-action">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
              </svg>
              <span>View PDF</span>
            </a>
          ) : (
            <span class="reading-action reading-action--off" title="PDF not available for this section">
              View PDF (Not Available)
            </span>
          )}

          {resourcesUrl ? (
            <ExternalLink href={resourcesUrl} class="reading-action">
              <FolderOpen size={16} aria-hidden="true" />
              <span>See Additional Resources</span>
            </ExternalLink>
          ) : null}

          <WorkLivesHere client:visible />
        </div>
      </Fragment>

      <slot />

      <Fragment slot="after">
        {citation && (
          <p class="module-citation" data-pagefind-ignore>{citation}</p>
        )}

        <!-- Section navigation for section-based pages -->
        <nav class="mt-12 pt-8 border-t border-border flex justify-between items-center no-print" data-pagefind-ignore>
          {sectionData.prev ? (
            <a
              href={sectionData.prev.href}
              class="inline-flex items-center text-text-secondary hover:text-text-primary transition-colors"
            >
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
              </svg>
              <span>Previous: {sectionData.prev.label}</span>
            </a>
          ) : (
            <a
              href={sectionData.modulePath || '/modules'}
              class="inline-flex items-center text-text-secondary hover:text-text-primary transition-colors"
            >
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
              </svg>
              Back to Overview
            </a>
          )}

          {sectionData.next && (
            <a
              href={sectionData.next.href}
              class="inline-flex items-center text-text-secondary hover:text-text-primary transition-colors ml-auto"
            >
              <span class="mr-2">Next: {sectionData.next.label}</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          )}
        </nav>
      </Fragment>
    </ReadingPage>
  ) : (
    <article class="container mx-auto px-4 py-8 max-w-4xl">
      <!-- Frontmatter-based header -->
      <header class="mb-8">
        {frontmatter && (
          <>
            <div class="flex flex-wrap items-center gap-2 mb-3">
              {frontmatter.phase && (
                <span class="meta-chip px-3 py-1 text-sm font-medium">
                  <span class={`meta-chip__dot meta-chip__dot--${frontmatter.phase.toLowerCase()}`} aria-hidden="true"></span>
                  {frontmatter.phase}
                </span>
              )}
              {frontmatter.difficulty && (
                <span class="meta-chip px-3 py-1 text-sm font-medium">
                  {frontmatter.difficulty}
                </span>
              )}
              {frontmatter.time_to_complete && (
                <span class="meta-chip px-3 py-1 text-sm font-medium">
                  {frontmatter.time_to_complete}
                </span>
              )}
            </div>

            <h1 class="text-hero font-bold text-foreground mb-3">
              {frontmatter.title}
            </h1>

            {frontmatter.summary && (
              <p class="text-lg text-muted-foreground">
                {frontmatter.summary}
              </p>
            )}

            {frontmatter.tags && frontmatter.tags.length > 0 && (
              <div class="flex flex-wrap gap-2 mt-4">
                {frontmatter.tags.map((tag) => (
                  <span class="px-2 py-1 text-chrome rounded bg-accent text-accent-foreground">
                    #{tag}
                  </span>
                ))}
              </div>
            )}
          </>
        )}
      </header>

      <!-- Module Content -->
      <div class="prose prose-lg max-w-none">
        <ArticleBody html={looseHtml} />
      </div>
    </article>
  )}

  {roundId && <AnnotationIsland roundId={roundId} client:load />}
</BaseLayout>
