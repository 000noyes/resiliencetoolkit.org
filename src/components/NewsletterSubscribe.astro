---
/**
 * Newsletter Subscription Component
 *
 * TODO: Add Beehiiv embed when publication ID is available.
 * Replace this placeholder with a Beehiiv iframe embed:
 * <iframe src="https://embeds.beehiiv.com/{publicationId}" width="100%" height="320" frameborder="0" scrolling="no"></iframe>
 */

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Subscribe to updates',
  description = 'Get notified when we release new features and improvements.'
} = Astro.props;
---

<div class="newsletter-subscribe bg-muted/50 border border-border rounded-lg p-6">
  <h3 class="text-lg font-semibold text-foreground mb-2">{title}</h3>
  <p class="text-sm text-muted-foreground mb-4">{description}</p>
  <p class="text-sm text-muted-foreground italic">Newsletter signup coming soon.</p>
</div>
