---
/**
 * RecoveryContinuum — the FEMA Disaster Recovery Continuum as toolkit wayfinding.
 *
 * Uses FEMA's own official Recovery Continuum graphic (a US government work, public
 * domain), self-hosted for offline use and attributed with a link out to the
 * National Disaster Recovery Framework. Below the graphic, our own toolkit-mapped
 * phases: each phase links to the matching workflow, and its recovery activities
 * cross-walk to toolkit modules where one genuinely matches. The graphic carries
 * the shape of recovery; the list carries the wayfinding and doubles as the text
 * alternative to the image. Zero client JS beyond the site's standard external-link
 * affordance; offline pure.
 *
 * Replaces the 3-stop PhaseSlider on /workflows and the wrong contamination PNG on
 * /introduction. Phase data + invariants live in src/data/recovery-continuum.ts.
 */
import { recoveryPhases } from '@/data/recovery-continuum';
import ExternalLink from '@/components/ExternalLink.astro';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const NDRF_URL = 'https://www.fema.gov/emergency-managers/national-preparedness/frameworks/recovery';

// The Disaster is the pivot drawn in the graphic, not a wayfinding destination.
const phases = recoveryPhases.filter((p) => !p.pivot);
---

<section class:list={['continuum', className]}>
  <div class="continuum__inner">
    <figure class="continuum__figure">
      <img
        class="continuum__img"
        src="/images/fema-recovery-continuum.png"
        width="800"
        height="329"
        alt="The FEMA Recovery Continuum. Preparedness is ongoing before a disaster. After the disaster, recovery unfolds in overlapping phases that grow in size and scope: short-term over days, intermediate over weeks to months, and long-term over months to years."
      />
      <figcaption class="continuum__cite text-body-small text-muted-foreground">
        Recovery Continuum from FEMA's <ExternalLink href={NDRF_URL}>National Disaster Recovery Framework</ExternalLink>.
      </figcaption>
    </figure>

    <nav aria-label="Phases of recovery">
      <ol class="continuum__columns">
        {
          phases.map((phase) => (
            <li class:list={['continuum__col', `continuum__col--${phase.id}`, phase.incomplete && 'is-incomplete']}>
              <a href={phase.href} class="continuum__col-link" aria-label={phase.linkLabel}>
                <span class="continuum__col-name">{phase.label}</span>
                <span class="continuum__col-time uppercase-accent">{phase.timeframe}</span>
                {phase.lead && <span class="continuum__col-lead uppercase-accent">{phase.lead}</span>}
              </a>
              {phase.activities && (
                <ul class="continuum__acts" aria-label={`${phase.label} recovery activities`}>
                  {phase.activities.map((a) => (
                    <li class="continuum__act">
                      {a.moduleHref ? (
                        <a href={a.moduleHref} class="continuum__act-link">{a.text}</a>
                      ) : (
                        <span>{a.text}</span>
                      )}
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ol>
    </nav>
  </div>
</section>

<style>
  .continuum {
    display: block;
  }

  /* Image and columns share ONE 800px box so the columns line up under the
     graphic's phases at any width (both are percentages of the same inner box). */
  .continuum__inner {
    max-width: 800px;
    margin: 0 auto;
  }

  /* ---- the official FEMA graphic ---- */
  .continuum__figure {
    margin: 0 0 0.5rem;
  }
  .continuum__img {
    display: block;
    width: 100%;
    height: auto;
  }
  .continuum__cite {
    margin-top: 0.75rem;
    text-align: center;
  }

  /* ---- MOBILE-FIRST: the four phases stack as a calm vertical reference ---- */
  .continuum__columns {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
  }
  .continuum__col {
    padding: 1.5rem 0;
    border-top: 1px solid var(--border);
  }
  .continuum__col:first-child {
    border-top: none;
    padding-top: 0.5rem;
  }

  /* the phase name is the wayfinding link; timeframe + lead stack beneath it */
  .continuum__col-link {
    display: inline-flex;
    flex-direction: column;
    gap: 0.15rem;
    text-decoration: none;
    color: inherit;
  }
  .continuum__col-name {
    font-weight: 600;
    font-size: 1.15rem;
    line-height: 1.3;
    color: var(--foreground);
  }
  .continuum__col-link:hover .continuum__col-name {
    color: var(--primary);
  }
  .continuum__col-time {
    color: var(--muted-foreground);
  }
  .continuum__col-lead {
    color: var(--primary);
  }

  /* scoped neutral focus ring (outscopes the global green a:focus-visible) */
  .continuum__col-link:focus-visible,
  .continuum__act-link:focus-visible {
    outline: 2px solid var(--foreground);
    outline-offset: 3px;
    border-radius: 4px;
  }

  /* activities: left-aligned calm prose, only on the recovery phases */
  .continuum__acts {
    list-style: none;
    margin: 0.9rem 0 0;
    padding: 0;
    max-width: 60ch;
  }
  .continuum__act {
    color: var(--muted-foreground);
    font-size: 0.95rem;
    line-height: 1.5;
    padding: 0.25rem 0;
  }
  .continuum__act-link {
    color: var(--foreground);
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-thickness: 1px;
  }

  /* ---- DESKTOP: four columns aligned UNDER the graphic's phases ----
     Track widths follow the measured phase regions of the 800px image:
     Preparedness 0-21%, Short-term 21-43%, Intermediate 43-68%, Long-term 68-100%
     (the Disaster bar at ~18% sits inside the Preparedness track, no column). */
  @media (min-width: 768px) {
    .continuum__columns {
      display: grid;
      grid-template-columns: 21% 22% 25% 32%;
      margin-top: 0.75rem;
      align-items: start;
    }
    .continuum__col {
      padding: 0.75rem 1.25rem 0 0;
      border-top: 2px solid var(--border);
    }
    .continuum__col:first-child {
      border-top: 2px solid var(--border);
      padding-top: 0.75rem;
    }
    .continuum__acts {
      margin-top: 0.75rem;
      max-width: none;
    }
    .continuum__act {
      font-size: 0.9rem;
    }
  }
</style>
