---
/**
 * The workshop round strip: names the round above the reviewed page and
 * carries the slot the annotation island fills with the round's status
 * (closed, or notes unavailable). Rendered only on /rounds/ URLs.
 */
interface Props {
  roundId: string;
}

const { roundId } = Astro.props;
const roundNumber = roundId.split('-')[0].replace(/^r/, '');
---

<div class="border-b border-border bg-card" data-annot-ui>
  <div class="container mx-auto px-4 py-2 text-center">
    <h2 class="inline text-body font-semibold text-foreground">Round {roundNumber}</h2><span
      class="text-body-small text-muted-foreground"> &middot; read together at the next meeting</span>
  </div>
</div>
<div id="round-status-slot" data-annot-ui></div>
