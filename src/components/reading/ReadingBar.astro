---
/**
 * The phone docked bar: the persistent home of the reading doors below
 * 1200px. The bar reserves its height in the layout (never overlay), sits
 * in the safe area, and each door opens a modal bottom sheet with a drag
 * handle and outside-tap dismissal. On this page is never in the bar; it
 * renders in flow at the top of the chapter.
 *
 * Doors arrive with their phases: Toolkit Contents here (P2), Footnotes
 * with the citations build, Make Comments on a workshop round (its sheet
 * is the phone home of the notes feed and compose, DR20). While a note
 * is being placed the bar carries the placing hint in place of its doors.
 */
import ToolkitContentsTree from './ToolkitContentsTree.astro';
import FootnotesTenant from './FootnotesTenant.astro';
import { TableOfContents as ContentsIcon, BookMarked, MessageSquare } from 'lucide-react';

interface Props {
  currentPath: string;
  sectionNumber: string;
  /** A workshop round: the Make Comments door and sheet join the bar */
  comments?: boolean;
}

const { currentPath, sectionNumber, comments = false } = Astro.props;
---

<nav class="reading-bar" data-annot-ui aria-label="Reading tools">
  <button
    type="button"
    class="reading-bar__door"
    data-sheet-open="contents"
    aria-haspopup="dialog"
    aria-expanded="false"
  >
    <ContentsIcon size={18} aria-hidden="true" />
    <span>Toolkit Contents</span>
  </button>
  <button
    type="button"
    class="reading-bar__door"
    data-sheet-open="footnotes"
    aria-haspopup="dialog"
    aria-expanded="false"
  >
    <BookMarked size={18} aria-hidden="true" />
    <span>Footnotes</span>
  </button>
  {comments && (
    <button
      type="button"
      class="reading-bar__door"
      data-sheet-open="make-comments"
      aria-haspopup="dialog"
      aria-expanded="false"
    >
      <MessageSquare size={18} aria-hidden="true" />
      <span>Make Comments</span>
    </button>
  )}
  {comments && <div class="reading-bar__hint" data-comments-mount="bar-hint"></div>}
</nav>

<div class="reading-sheet" data-annot-ui data-sheet="contents" hidden>
  <div class="reading-sheet__backdrop" data-sheet-dismiss></div>
  <div
    class="reading-sheet__body"
    role="dialog"
    aria-modal="true"
    aria-label="Toolkit Contents"
    tabindex="-1"
  >
    <div class="reading-sheet__handle" aria-hidden="true"></div>
    <div class="reading-sheet__bar">
      <button type="button" class="reading-sheet__close" data-sheet-dismiss>
        Close
      </button>
    </div>
    <div class="reading-sheet__scroll">
      <ToolkitContentsTree currentPath={currentPath} variant="sheet" />
    </div>
  </div>
</div>

<div class="reading-sheet" data-annot-ui data-sheet="footnotes" hidden>
  <div class="reading-sheet__backdrop" data-sheet-dismiss></div>
  <div
    class="reading-sheet__body"
    role="dialog"
    aria-modal="true"
    aria-label="Footnotes"
    tabindex="-1"
  >
    <div class="reading-sheet__handle" aria-hidden="true"></div>
    <div class="reading-sheet__bar">
      <h2 class="reading-rail__panel-title">Footnotes</h2>
      <button type="button" class="reading-sheet__close" data-sheet-dismiss>
        Close
      </button>
    </div>
    <div class="reading-sheet__scroll">
      <FootnotesTenant sectionNumber={sectionNumber} />
    </div>
  </div>
</div>

{comments && (
  <div class="reading-sheet" data-annot-ui data-sheet="make-comments" hidden>
    <div class="reading-sheet__backdrop" data-sheet-dismiss></div>
    <div
      class="reading-sheet__body"
      role="dialog"
      aria-modal="true"
      aria-label="Make Comments"
      tabindex="-1"
    >
      <div class="reading-sheet__handle" aria-hidden="true"></div>
      <div class="reading-sheet__bar">
        <h2 class="reading-rail__panel-title">Make Comments</h2>
        <button type="button" class="reading-sheet__close" data-sheet-dismiss>
          Close
        </button>
      </div>
      <div class="reading-sheet__scroll comments-tenant" data-comments-mount="sheet"></div>
    </div>
  </div>
)}

<script>
  import { atOrAbove } from '@/lib/breakpoints.mjs';

  const closers = new Map<string, () => void>();

  function wireSheets() {
    document.querySelectorAll<HTMLElement>('[data-sheet]').forEach((sheet) => {
      const name = sheet.getAttribute('data-sheet');
      const opener = document.querySelector<HTMLButtonElement>(
        `[data-sheet-open="${name}"]`
      );
      const body = sheet.querySelector<HTMLElement>('.reading-sheet__body');
      if (!opener || !body) return;

      const close = () => {
        sheet.hidden = true;
        opener.setAttribute('aria-expanded', 'false');
        document.documentElement.style.removeProperty('overflow');
        opener.focus();
      };
      closers.set(name ?? '', close);
      const open = () => {
        sheet.hidden = false;
        opener.setAttribute('aria-expanded', 'true');
        document.documentElement.style.setProperty('overflow', 'hidden');
        body.focus();
      };

      opener.addEventListener('click', open);
      sheet.querySelectorAll('[data-sheet-dismiss]').forEach((el) => {
        el.addEventListener('click', close);
      });
      sheet.addEventListener('keydown', (e) => {
        if ((e as KeyboardEvent).key === 'Escape') close();
      });
      // Navigating from a sheet link closes it (same-page anchors included)
      sheet.querySelectorAll('a').forEach((a) => {
        a.addEventListener('click', () => close());
      });
    });
  }
  wireSheets();

  // The page reserves the bar's actual height (a label that wraps at a
  // large text size makes the bar taller than its floor). The safe-area
  // inset is the bar's own bottom padding, so it is measured out.
  const bar = document.querySelector<HTMLElement>('.reading-bar');
  if (bar && 'ResizeObserver' in window) {
    const reserve = () => {
      const inset = parseFloat(getComputedStyle(bar).paddingBottom) || 0;
      document.documentElement.style.setProperty(
        '--reading-bar-h',
        `${Math.max(56, Math.round(bar.offsetHeight - inset))}px`
      );
    };
    new ResizeObserver(reserve).observe(bar);
    reserve();
  }

  // The sheets' lifecycle ends at reading: crossing the line with one open
  // closes it (the lock releases with it) and focus goes to what replaces
  // it: the contents tree, or the tenant's edge button in the rail
  const readingQuery = window.matchMedia(atOrAbove('reading'));
  readingQuery.addEventListener('change', (e) => {
    if (!e.matches) return;
    document.querySelectorAll<HTMLElement>('[data-sheet]').forEach((sheet) => {
      if (sheet.hidden) return;
      const name = sheet.getAttribute('data-sheet') ?? '';
      closers.get(name)?.();
      const replacement =
        name === 'contents'
          ? document.querySelector<HTMLElement>(
              '.reading-grid[data-tree="closed"] [data-tree-btn], #toolkit-contents-tree'
            )
          : document.querySelector<HTMLElement>(`[data-rail-btn="${name}"]`);
      replacement?.focus();
    });
  });
</script>
