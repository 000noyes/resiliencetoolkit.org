---
/**
 * The article body render: the page's own content with static heading
 * ids, the one id system that search landings and On this page share
 * (SR3/ES3), and, on the pages a reader can annotate, per-block ids in
 * the kept API's shape (ER4/DR18). The layout renders the page body once
 * in its frontmatter, runs the id passes, reads the headings for On this
 * page, and hands the finished HTML here (the slot form has retired).
 */
interface Props {
  html: string;
}

const { html } = Astro.props;
---

<Fragment set:html={html} />
