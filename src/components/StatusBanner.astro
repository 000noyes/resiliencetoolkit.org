---
// Status banner shows online/offline status and sync information.
// Its script is Astro-processed (bundled, not is:inline), so it can import
// from @/lib/notices and participate in the single-slot notice registry the
// React banners use.
---

<div
  id="status-banner"
  class="bg-muted text-muted-foreground px-4 py-2 text-sm text-center hidden no-print"
  role="status"
  aria-live="polite"
  aria-atomic="true"
>
  <span id="status-text">You're working offline. Your work still saves on this device.</span>
</div>

<script>
  import { claimNotice, releaseNotice, getActiveNotice, NOTICE_CHANGED_EVENT } from '@/lib/notices';

  const banner = document.getElementById('status-banner');
  const statusText = document.getElementById('status-text');

  // The single 3s back-online timer. Held so a re-offline event within the
  // flash window can clear it — otherwise the stale timer would hide the
  // freshly re-shown offline notice.
  let backOnlineTimer: ReturnType<typeof setTimeout> | null = null;

  function clearBackOnlineTimer() {
    if (backOnlineTimer !== null) {
      clearTimeout(backOnlineTimer);
      backOnlineTimer = null;
    }
  }

  // Render only while `status` is the registry winner; the single slot keeps
  // the strip hidden whenever a higher-priority notice (acute storage) holds it.
  function renderWinner() {
    if (!banner) return;
    let winner: boolean;
    try {
      winner = getActiveNotice() === 'status';
    } catch {
      winner = true; // fail toward showing our own claim
    }
    banner.classList.toggle('hidden', !winner);
  }

  function showOffline() {
    if (!banner || !statusText) return;
    clearBackOnlineTimer();
    banner.classList.remove('notice-online-flash');
    banner.classList.add('bg-muted', 'text-muted-foreground');
    statusText.textContent = "You're working offline. Your work still saves on this device.";
    claimNotice('status');
    renderWinner();
  }

  function showBackOnline() {
    if (!banner || !statusText) return;
    clearBackOnlineTimer();
    banner.classList.remove('bg-muted', 'text-muted-foreground');
    banner.classList.add('notice-online-flash');
    statusText.textContent = "You're back online.";
    claimNotice('status');
    renderWinner();
    // Flash for 3s, then release the slot and let the next claimant appear.
    backOnlineTimer = setTimeout(() => {
      backOnlineTimer = null;
      releaseNotice('status');
      renderWinner();
    }, 3000);
  }

  // Initialize status
  if (!navigator.onLine) showOffline();

  // Listen for network status changes
  document.addEventListener('network-status-change', ((event: CustomEvent) => {
    if (event.detail.online) showBackOnline();
    else showOffline();
  }) as EventListener);

  // Also listen to native events as backup
  window.addEventListener('online', () => showBackOnline());
  window.addEventListener('offline', () => showOffline());

  // Recompute our winner state whenever any strip claims or releases the slot.
  document.addEventListener(NOTICE_CHANGED_EVENT, renderWinner);
</script>
