{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/pages/**/*.{astro,ts,tsx}",
    "scripts/**/*.{ts,mjs}",
    "tests/**/*.{ts,tsx}",
    "functions/api/**/*.ts",
    "playwright.offline.config.ts",
    "playwright.workshop.config.ts",
    "playwright.layout.config.ts",
    "playwright.search.config.ts"
  ],
  "project": [
    "src/**/*.{astro,ts,tsx}",
    "scripts/**/*.{ts,mjs}",
    "functions/**/*.ts"
  ],
  "ignore": [
    "src/components/PlanForm.tsx",
    "src/components/reading/ColophonLine.astro"
  ],
  "ignoreUnresolved": [
    "/pagefind/pagefind.js"
  ]
}
